#: lib/MountCheck.php
msgid "Unable to read the mount table, so the mount could not be confirmed read-only."
msgstr "მიმაგრებების ცხრილის წაკითხვა ვერ მოხერხდა, ამიტომ ვერ დადასტურდა, რომ მიმაგრება მხოლოდ წასაკითხია."

#: lib/MountCheck.php
#, php-format
msgid "%s is on a read-only mount."
msgstr "%s მდებარეობს მხოლოდ წასაკითხ მიმაგრებაზე."

#: lib/MountCheck.php
#, php-format
msgid "%s is on the writable mount %s. Mount SmokePing's data directory read-only."
msgstr "%s მდებარეობს ჩაწერად მიმაგრებაზე %s. მიამაგრეთ SmokePing-ის მონაცემთა დირექტორია მხოლოდ წაკითხვის რეჟიმში."

#: lib/MountCheck.php
msgid "No inventory yet, so no RRD files are expected."
msgstr "ინვენტარი ჯერ არ არის, ამიტომ RRD ფაილები მოსალოდნელი არ არის."

#: lib/MountCheck.php
#, php-format
msgid "All %d expected RRD files are visible through the mount."
msgstr "ყველა %d მოსალოდნელი RRD ფაილი ჩანს მიმაგრების გავლით."

#: lib/MountCheck.php
#, php-format
msgid "%d of %d expected RRD files are not visible through the mount, for example %s."
msgstr "%d (%d-დან) მოსალოდნელი RRD ფაილი არ ჩანს მიმაგრების გავლით, მაგალითად %s."

