#: include/operator.php lib/ViewPage.php
msgid "Master"
msgstr "মাস্টার"

#: include/operator.php
msgid "Compare loss and latency with the SmokePing graphs and maintenance state. Escalate missing files, imports and relinking to an administrator."
msgstr "SmokePing গ্রাফ এবং রক্ষণাবেক্ষণ অবস্থার সাথে প্যাকেট লস ও লেটেন্সি তুলনা করুন। অনুপস্থিত ফাইল, ইম্পোর্ট এবং রি-লিংকিংয়ের বিষয়টি অ্যাডমিনিস্ট্রেটরের কাছে পাঠান।"

#: lib/ActionOutcome.php
#, php-format
msgid "skipped, %s"
msgstr "উপেক্ষিত, %s"

#: lib/ConfigPage.php
msgid "XML"
msgstr "XML"

#: lib/ConfigPage.php
msgid "YAML (default)"
msgstr "YAML (ডিফল্ট)"

#: lib/ConfigPage.php lib/Pages.php
msgid "SmokePing Configuration"
msgstr "SmokePing কনফিগারেশন"

#: lib/ConfigPage.php
msgid "Your device permissions do not cover every device, so you cannot export or import the SmokePing configuration. Ask an administrator with access to all devices."
msgstr "আপনার ডিভাইস অনুমতি সব ডিভাইসকে অন্তর্ভুক্ত করে না, তাই আপনি SmokePing কনফিগারেশন এক্সপোর্ট বা ইম্পোর্ট করতে পারবেন না। সব ডিভাইসে অ্যাক্সেস আছে এমন কোনো অ্যাডমিনিস্ট্রেটরকে অনুরোধ করুন।"

#: lib/ConfigPage.php
msgid "Export the SmokePing Configuration"
msgstr "SmokePing কনফিগারেশন এক্সপোর্ট করুন"

#: lib/ConfigPage.php
msgid "The export holds the plugin settings, the SmokePing targets the plugin has read, and which device each is mapped to, by the device's host name and description. It holds no data source, graph, RRD file, or credential."
msgstr "এক্সপোর্টে প্লাগইন সেটিংস, প্লাগইনের পঠিত SmokePing টার্গেটসমূহ এবং ডিভাইসের হোস্ট নাম ও বিবরণ অনুযায়ী প্রতিটি টার্গেট কোন ডিভাইসের সাথে ম্যাপ করা আছে তা সংরক্ষিত থাকে। এতে কোনো ডেটা সোর্স, গ্রাফ, RRD ফাইল বা ক্রেডেনশিয়াল থাকে না।"

#: lib/ConfigPage.php
msgid "Download"
msgstr "ডাউনলোড"

#: lib/ConfigPage.php
msgid "Import a SmokePing Configuration"
msgstr "একটি SmokePing কনফিগারেশন ইম্পোর্ট করুন"

#: lib/ConfigPage.php
msgid "Choosing a file only checks it. The next screen lists every change the file would make, and nothing is written until you confirm that list. An import adds and updates; it never deletes a target or moves a mapping, and it never creates an RRD file or touches the SmokePing data directory."
msgstr "একটি ফাইল নির্বাচন করলে তা কেবল পরীক্ষা করা হয়। পরবর্তী স্ক্রিনে ফাইলটি যেসব পরিবর্তন করবে তার প্রতিটি তালিকাভুক্ত থাকে এবং আপনি সেই তালিকা নিশ্চিত না করা পর্যন্ত কোনো কিছুই সংরক্ষণ করা হয় না। ইম্পোর্ট কেবল যোগ ও হালনাগাদ করে; এটি কখনোই কোনো টার্গেট মুছে ফেলে না বা ম্যাপিং স্থানান্তর করে না, এবং এটি কখনোই কোনো RRD ফাইল তৈরি করে না বা SmokePing ডেটা ডিরেক্টরি স্পর্শ করে না।"

#: lib/ConfigPage.php
msgid "Check File"
msgstr "ফাইল পরীক্ষা করুন"

#: lib/ConfigPage.php lib/ImportPage.php
msgid "Import Check"
msgstr "ইম্পোর্ট পরীক্ষা"

#: lib/ConfigPage.php
msgid "Nothing was written."
msgstr "কোনো কিছুই সংরক্ষণ করা হয়নি।"

#: lib/ConfigPage.php lib/ImportPage.php smokeping_import.php
msgid "Back"
msgstr "পিছনে"

#: lib/ConfigPage.php
msgid "The file cannot be imported until these errors are fixed. Nothing was written."
msgstr "এই ত্রুটিগুলো সমাধান না হওয়া পর্যন্ত ফাইলটি ইম্পোর্ট করা যাবে না। কোনো কিছুই সংরক্ষণ করা হয়নি।"

#: lib/ConfigPage.php
msgid "The installation already matches the file. There is nothing to import."
msgstr "ইনস্টলেশনটি ইতিমধ্যেই ফাইলের সাথে মিলে গেছে। ইম্পোর্ট করার মতো কিছু নেই।"

#: lib/ConfigPage.php
#, php-format
msgid "Plan %s. Applying makes exactly these changes in one transaction. If the file or the installation changed since this check, the import is refused and you check again."
msgstr "পরিকল্পনা %s। প্রয়োগ করলে একটি ট্রানজ্যাকশনে ঠিক এই পরিবর্তনগুলোই করা হবে। এই পরীক্ষার পর ফাইল বা ইনস্টলেশন পরিবর্তিত হলে ইম্পোর্ট প্রত্যাখ্যান করা হবে এবং আপনাকে পুনরায় পরীক্ষা করতে হবে।"

#: lib/ConfigPage.php
msgid "Apply Import"
msgstr "ইম্পোর্ট প্রয়োগ করুন"

#: lib/ConfigPage.php lib/ImportPage.php lib/InventoryForms.php
msgid "Cancel"
msgstr "বাতিল করুন"

#: lib/DeviceActions.php
msgid "Add SmokePing Targets"
msgstr "SmokePing টার্গেট যোগ করুন"

#: lib/DeviceActions.php
msgid "no matching SmokePing target"
msgstr "মিল থাকা কোনো SmokePing টার্গেট নেই"

#: lib/DeviceActions.php
msgid "Click Continue to add the SmokePing targets whose host is the host name of each selected device. Each target gets a summary graph for alerting and, when SmokePing's data can be graphed, a smoke graph. Devices are never created here."
msgstr "নির্বাচিত প্রতিটি ডিভাইসের হোস্ট নামের সাথে মিলে যাওয়া হোস্টযুক্ত SmokePing টার্গেটগুলো যোগ করতে চালিয়ে যান-এ ক্লিক করুন। প্রতিটি টার্গেট সতর্কীকরণের জন্য একটি সারাংশ গ্রাফ এবং SmokePing-এর ডেটা গ্রাফ করা সম্ভব হলে একটি স্মোক গ্রাফ পায়। এখানে কখনোই ডিভাইস তৈরি করা হয় না।"

#: lib/DeviceActions.php
#, php-format
msgid "%d targets match."
msgstr "%dটি টার্গেট মিলেছে।"

#: lib/DeviceActions.php
#, php-format
msgid "%d objects created or mapped, %d skipped."
msgstr "%dটি অবজেক্ট তৈরি বা ম্যাপ করা হয়েছে, %dটি উপেক্ষা করা হয়েছে।"

#: lib/DeviceSaveCheck.php
#, php-format
msgid "This device has SmokePing targets, but the reader that fills their summary values runs on poller %d and the device is saved on poller %d. Summary values and alerts stop until the device is assigned to poller %d again."
msgstr "এই ডিভাইসটিতে SmokePing টার্গেট রয়েছে, কিন্তু যে রিডার এগুলোর সারাংশ মান পূরণ করে তা পোলার %d-এ চলে এবং ডিভাইসটি পোলার %d-এ সংরক্ষিত রয়েছে। ডিভাইসটিকে পুনরায় পোলার %d-এ নির্ধারণ না করা পর্যন্ত সারাংশ মান এবং সতর্কতা বন্ধ থাকবে।"

#: lib/GraphLinks.php
msgid "SmokePing Targets of this Device"
msgstr "এই ডিভাইসের SmokePing টার্গেটসমূহ"

#: lib/HealthCheck.php
#, php-format
msgid "%d smoke graphs still draw the other colors; the main poller moves up to 200 per cycle."
msgstr "%dটি স্মোক গ্রাফ এখনো অন্য রঙগুলো অঙ্কন করছে; মূল পোলার প্রতি চক্রে সর্বোচ্চ 200টি স্থানান্তর করে।"

#: lib/HealthCheck.php
#, php-format
msgid "%d smoke graphs could not be moved; run upgrade-graphs to try them again, and see the Cacti log for the cause."
msgstr "%dটি স্মোক গ্রাফ স্থানান্তর করা যায়নি; পুনরায় চেষ্টা করতে upgrade-graphs চালান এবং কারণ জানতে Cacti লগ দেখুন।"

#: lib/HealthCheck.php
#, php-format
msgid "The Loss Colors setting asks for SmokePing %s loss colors, but the reader found SmokePing %s. Set it to Automatic unless the graphs should differ from SmokePing's."
msgstr "লস কালার সেটিংস SmokePing %s-এর লস কালার চায়, কিন্তু রিডার SmokePing %s খুঁজে পেয়েছে। গ্রাফগুলো SmokePing-এর থেকে ভিন্ন হওয়া উচিত না হলে এটি স্বয়ংক্রিয়তে সেট করুন।"

#: lib/HealthCheck.php
#, php-format
msgid "The Loss Colors setting selects SmokePing %s loss colors for smoke graphs."
msgstr "লস কালার সেটিংস স্মোক গ্রাফের জন্য SmokePing %s-এর লস কালার নির্বাচন করে।"

#: lib/HealthCheck.php
msgid "The reader found no SmokePing version, so the Loss Colors setting selects the loss colors of SmokePing 2.8 and later. If SmokePing is 2.7, set Loss Colors to SmokePing 2.7."
msgstr "রিডার কোনো SmokePing সংস্করণ খুঁজে পায়নি, তাই লস কালার সেটিংস SmokePing 2.8 এবং পরবর্তী সংস্করণের লস কালার নির্বাচন করে। যদি SmokePing 2.7 হয়, তবে লস কালার SmokePing 2.7-এ সেট করুন।"

#: lib/HealthCheck.php
#, php-format
msgid "The reader found SmokePing %s, so the Loss Colors setting selects its loss colors."
msgstr "রিডার SmokePing %s খুঁজে পেয়েছে, তাই লস কালার সেটিংস এর লস কালার নির্বাচন করে।"

#: lib/HealthCheck.php
msgid "Thold is not installed, so no target alerts in both SmokePing and Thold."
msgstr "Thold ইনস্টল করা নেই, তাই কোনো টার্গেটই SmokePing এবং Thold উভয়ে সতর্কতা পাঠায় না।"

#: lib/HealthCheck.php
msgid "No target has both a SmokePing alert and an enabled Thold threshold."
msgstr "কোনো টার্গেটেই SmokePing সতর্কতা এবং সক্রিয় Thold থ্রেশহোল্ড উভয়ই নেই।"

#: lib/HealthCheck.php
#, php-format
msgid "%d targets have both a SmokePing alert and an enabled Thold threshold, so one problem may notify twice. Compare their alert conditions before removing either: %s"
msgstr "%dটি টার্গেটে SmokePing সতর্কতা এবং সক্রিয় Thold থ্রেশহোল্ড উভয়ই রয়েছে, তাই একটি সমস্যায় দুবার বিজ্ঞপ্তি আসতে পারে। যেকোনো একটি সরানোর আগে এদের সতর্কতার শর্তগুলো তুলনা করুন: %s"

#: lib/HealthCheck.php
#, php-format
msgid "The SmokePing templates failed to import and are not retried automatically: %s Use Retry Template Import after fixing the cause."
msgstr "SmokePing টেমপ্লেটগুলো ইম্পোর্ট করতে ব্যর্থ হয়েছে এবং স্বয়ংক্রিয়ভাবে পুনরায় চেষ্টা করা হবে না: %s কারণটি সমাধান করার পর 'টেমপ্লেট ইম্পোর্ট পুনরায় চেষ্টা করুন' ব্যবহার করুন।"

#: lib/HealthCheck.php
msgid "The SmokePing templates are not imported. Use Retry Template Import."
msgstr "SmokePing টেমপ্লেটগুলো ইম্পোর্ট করা হয়নি। 'টেমপ্লেট ইম্পোর্ট পুনরায় চেষ্টা করুন' ব্যবহার করুন।"

#: lib/HealthCheck.php smokeping_health.php
msgid "The SmokePing templates are imported."
msgstr "SmokePing টেমপ্লেটগুলো ইম্পোর্ট করা হয়েছে।"

#: lib/HealthCheck.php
msgid "Every device with summary data sources is polled by the reader's poller."
msgstr "সারাংশ ডেটা সোর্সযুক্ত প্রতিটি ডিভাইস রিডারের পোলার দ্বারা পোল করা হয়।"

#: lib/HealthCheck.php
#, php-format
msgid "%d devices have summary data sources but are not polled by poller %d, which runs the reader, so their summary values and alerts have no data: %s"
msgstr "%dটি ডিভাইসে সারাংশ ডেটা সোর্স রয়েছে কিন্তু যে পোলার %d রিডার চালায় তা দিয়ে এগুলো পোল করা হয় না, তাই এদের সারাংশ মান এবং সতর্কতায় কোনো ডেটা নেই: %s"

#: lib/HealthCheck.php
#, php-format
msgid "The SmokePing configuration is read on poller %d, not on this server; the inventory row shows the result of its last read."
msgstr "SmokePing কনফিগারেশন এই সার্ভারে নয় বরং পোলার %d-এ পড়া হয়; ইনভেন্টরি সারিতে এর সর্বশেষ পাঠের ফলাফল দেখানো হয়েছে।"

#: lib/HealthCheck.php
#, php-format
msgid "The SmokePing configuration %s cannot be read: %s"
msgstr "SmokePing কনফিগারেশন %s পড়া যাচ্ছে না: %s"

#: lib/HealthCheck.php
#, php-format
msgid "The SmokePing configuration %s lists %d targets; %d entries are skipped: %s"
msgstr "SmokePing কনফিগারেশন %s-এ %dটি টার্গেট তালিকাভুক্ত রয়েছে; %dটি এন্ট্রি উপেক্ষা করা হয়েছে: %s"

#: lib/HealthCheck.php
#, php-format
msgid "The SmokePing configuration %s lists %d targets."
msgstr "SmokePing কনফিগারেশন %s-এ %dটি টার্গেট তালিকাভুক্ত রয়েছে।"

#: lib/HealthCheck.php
msgid "The PHP binary path setting is empty or not an executable file, so the reader cannot start."
msgstr "PHP বাইনারি পাথ সেটিংস খালি অথবা কার্যকরযোগ্য ফাইল নয়, তাই রিডার শুরু হতে পারছে না।"

#: lib/HealthCheck.php
#, php-format
msgid "The reader starts with %s."
msgstr "রিডার %s দিয়ে শুরু হয়।"

#: lib/HealthCheck.php
msgid "The reader has not completed a run on this poller."
msgstr "রিডার এই পোলারে কোনো রান সম্পন্ন করেনি।"

#: lib/HealthCheck.php
#, php-format
msgid "The last reader run finished %d seconds ago, more than three poller intervals."
msgstr "সর্বশেষ রিডার রান %d সেকেন্ড আগে শেষ হয়েছে, যা তিনটি পোলার ব্যবধানের চেয়ে বেশি।"

#: lib/HealthCheck.php
#, php-format
msgid "The reader read %d of %d series in %.1f seconds and has exceeded its time budget %d times."
msgstr "রিডার %dটি (মোট %dটির মধ্যে) সিরিজ %.1f সেকেন্ডে পড়েছে এবং %d বার এর সময়সীমা অতিক্রম করেছে।"

#: lib/HealthCheck.php
#, php-format
msgid "The reader read %d of %d series in %.1f seconds, %d seconds ago."
msgstr "রিডার %dটি (মোট %dটির মধ্যে) সিরিজ %.1f সেকেন্ডে পড়েছে, %d সেকেন্ড আগে।"

#: lib/HealthCheck.php
msgid "No inventory has been read on this poller."
