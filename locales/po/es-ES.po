#: lib/ImportPage.php
msgid "Configuration"
msgstr "Configuración"

#: lib/ImportPage.php
msgid "The configured SmokePing file is read with the files it includes, from its own directory. An uploaded file is read on its own: @include is not allowed in it."
msgstr "El archivo de SmokePing configurado se lee junto con los archivos que incluye, desde su propio directorio. Un archivo cargado se lee por sí solo: no se permite @include en él."

#: lib/ImportPage.php
#, php-format
msgid "The configured file, %s"
msgstr "El archivo configurado, %s"

#: lib/ImportPage.php
msgid "An uploaded file, without @include"
msgstr "Un archivo cargado, sin @include"

#: lib/ImportPage.php
msgid "Uploaded File"
msgstr "Archivo cargado"

#: lib/ImportPage.php
msgid "Only for an uploaded file: a SmokePing configuration of at most 4 MiB."
msgstr "Solo para un archivo cargado: una configuración de SmokePing de 4 MiB como máximo."

#: lib/ImportPage.php
msgid "Devices"
msgstr "Dispositivos"

#: lib/ImportPage.php
msgid "One device per SmokePing host groups targets that probe the same host. A device that already has the host name on the chosen poller is used instead of a new one."
msgstr "Un dispositivo por host de SmokePing agrupa los destinos que sondean el mismo host. Se usa un dispositivo que ya tenga ese nombre de host en el sondeador elegido en lugar de crear uno nuevo."

#: lib/ImportPage.php
msgid "One device per SmokePing host"
msgstr "Un dispositivo por host de SmokePing"

#: lib/ImportPage.php
msgid "One device per SmokePing target"
msgstr "Un dispositivo por destino de SmokePing"

#: lib/ImportPage.php
msgid "Device Template"
msgstr "Plantilla de dispositivo"

#: lib/ImportPage.php
msgid "The template of devices the import creates."
msgstr "La plantilla de los dispositivos que crea la importación."

#: lib/ImportPage.php
msgid "Poller"
msgstr "Sondeador"

#: lib/ImportPage.php
msgid "The poller of new devices. It must be the poller that runs the SmokePing reader, or their summary data sources get no data."
msgstr "El sondeador de los dispositivos nuevos. Debe ser el sondeador que ejecuta el lector de SmokePing; de lo contrario, sus fuentes de datos de resumen no reciben datos."

#: lib/ImportPage.php
msgid "Site"
msgstr "Sitio"

