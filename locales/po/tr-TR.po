#: smokeping_config.php smokeping_import.php
msgid "No file was uploaded, or it is larger than the server accepts."
msgstr "Hiçbir dosya yüklenmedi veya dosya sunucunun kabul ettiğinden daha büyük."

#: smokeping_config.php
msgid "There is no checked import to apply. Check the file again."
msgstr "Uygulanacak denetlenmiş bir içe aktarım yok. Dosyayı tekrar denetleyin."

#: smokeping_config.php
msgid "The configuration was imported."
msgstr "Yapılandırma içe aktarıldı."

#: smokeping_health.php
msgid "The SmokePing templates failed to import. See the health table."
msgstr "SmokePing şablonları içe aktarılamadı. Sağlık tablosuna bakın."

#: smokeping_import.php
msgid "Your device permissions do not cover every device, so you cannot import a SmokePing configuration. Ask an administrator with access to all devices."
msgstr "Cihaz izinleriniz tüm cihazları kapsamadığından bir SmokePing yapılandırmasını içe aktaramazsınız. Tüm cihazlara erişimi olan bir yöneticiden yardım isteyin."

#: smokeping_import.php
msgid "Name the new graph tree, or choose an existing tree or no tree."
msgstr "Yeni grafik ağacına bir ad verin ya da mevcut bir ağacı veya ağaç olmamasını seçin."

#: smokeping_import.php
msgid "The uploaded file is larger than 4 MiB."
msgstr "Yüklenen dosya 4 MiB'den büyük."

#: smokeping_import.php
#, php-format
msgid "The SmokePing configuration cannot be read, so nothing was imported: %s"
msgstr "SmokePing yapılandırması okunamadığından hiçbir şey içe aktarılmadı: %s"

#: smokeping_import.php
msgid "There is no previewed import to apply. Preview it again."
msgstr "Uygulanacak önizlenmiş bir içe aktarım yok. Yeniden önizleyin."

#: smokeping_import.php
#, php-format
msgid "and %d more; see the Cacti log"
msgstr "ve %d tane daha; Cacti günlüğüne bakın"

#: smokeping_import.php
msgid "The SmokePing configuration was imported."
msgstr "SmokePing yapılandırması içe aktarıldı."

#: smokeping_inventory.php
msgid "Choose a target on this poller and, to map it, a device you may change."
msgstr "Bu yoklayıcıda bir hedef ve onu eşlemek için değiştirme yetkiniz olan bir cihaz seçin."

#: smokeping_inventory.php
msgid "The proposal is not open, or it involves a device or poller you may not change."
msgstr "Öneri açık değil ya da değiştirme yetkiniz olmayan bir cihaz veya yoklayıcı içeriyor."

#: smokeping_inventory.php
msgid "The proposal was dismissed."
msgstr "Öneri reddedildi."

#: smokeping_operator.php
msgid "Monitoring view"
msgstr "İzleme görünümü"

#: smokeping_operator.php
msgid "Observations could not be read. Ask an administrator to check the plugin log."
msgstr "Gözlemler okunamadı. Bir yöneticiden eklenti günlüğünü kontrol etmesini isteyin."
