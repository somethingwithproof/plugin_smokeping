msgstr "Aucun inventaire n'a été lu sur ce collecteur."

#: lib/HealthCheck.php
#, php-format
msgid "The last inventory failed %d seconds ago and the previous one is still in use: %s"
msgstr "Le dernier inventaire a échoué il y a %d secondes et le précédent est toujours utilisé : %s"

#: lib/HealthCheck.php
#, php-format
msgid "The inventory listed %d targets %d seconds ago."
msgstr "L'inventaire a répertorié %d cibles il y a %d secondes."

