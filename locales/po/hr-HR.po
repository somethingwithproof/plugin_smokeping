msgstr "Konfiguraciju nije moguće uvesti dok se gornje pogreške ne isprave. Ništa nije zapisano."

#: lib/ImportPage.php
msgid "Every selected target is already in Cacti. There is nothing to import."
msgstr "Svaki odabrani cilj već postoji u sustavu Cacti. Nema ničega za uvoz."

#: lib/ImportPage.php
#, php-format
msgid "Plan %s. Importing creates exactly what is listed above through Cacti's device, graph, and tree functions. If the SmokePing configuration or Cacti changed since this preview, the import is refused and you preview again."
msgstr "Plan %s. Uvoz stvara točno ono što je navedeno gore pomoću funkcija sustava Cacti za uređaje, grafove i stabla. Ako su se konfiguracija SmokePinga ili Cacti promijenili od ovog pretpregleda, uvoz će biti odbijen te trebate ponoviti pretpregled."

#: lib/ImportPage.php
#, php-format
msgid "%s and %d more"
msgstr "%s i još %d"

#: lib/InventoryForms.php
#, php-format
msgid "Add %s to Cacti"
msgstr "Dodaj %s u Cacti"

#: lib/InventoryForms.php
#, php-format
msgid "SmokePing target %s (host %s) has no Cacti device. Choose what to do with it."
msgstr "Cilj SmokePinga %s (računalo %s) nema uređaj u sustavu Cacti. Odaberite što učiniti s njim."

#: lib/InventoryForms.php
msgid "Create a new device from the SmokePing Target template"
msgstr "Stvori novi uređaj iz predloška SmokePing Target"

#: lib/InventoryForms.php
msgid "Map it to an existing device"
msgstr "Pridruži ga postojećem uređaju"

#: lib/InventoryForms.php
msgid "Either way the target gets a summary graph for alerting and, when SmokePing's data can be graphed, a smoke graph. Cacti never writes SmokePing's files."
msgstr "U oba slučaja cilj dobiva sažeti graf za uzbunjivanje i, kada se podaci SmokePinga mogu prikazati grafom, smoke graf. Cacti nikada ne zapisuje u datoteke SmokePinga."

#: lib/InventoryForms.php
msgid "Add"
msgstr "Dodaj"

#: lib/InventoryForms.php
msgid "Confirm Re-link"
msgstr "Potvrdi ponovno povezivanje"

#: lib/InventoryForms.php
