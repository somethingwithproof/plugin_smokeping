msgid "Inventory Interval"
msgstr "Inventeringsintervall"

#: lib/Settings.php
msgid "Minimum seconds between inventory runs. The inventory also runs when the configuration file changes."
msgstr "Minsta antal sekunder mellan inventeringskörningar. Inventeringen körs även när konfigurationsfilen ändras."

