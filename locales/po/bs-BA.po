#: lib/ImportPage.php
msgid "Estimate"
msgstr "Procjena"

#: lib/ImportPage.php
msgid "Estimated Load"
msgstr "Procijenjeno opterećenje"

#: lib/ImportPage.php
msgid "Confirm"
msgstr "Potvrdi"

#: lib/ImportPage.php
msgid "The configuration cannot be imported until the errors above are fixed. Nothing was written."
msgstr "Konfiguracija se ne može uvesti dok se navedene greške ne isprave. Ništa nije upisano."

#: lib/ImportPage.php
msgid "Every selected target is already in Cacti. There is nothing to import."
msgstr "Svaki odabrani cilj je već u Cactiju. Nema ništa za uvoz."

#: lib/ImportPage.php
#, php-format
msgid "Plan %s. Importing creates exactly what is listed above through Cacti's device, graph, and tree functions. If the SmokePing configuration or Cacti changed since this preview, the import is refused and you preview again."
msgstr "Plan %s. Uvoz kreira tačno ono što je gore navedeno putem Cacti funkcija za uređaje, grafikone i stabla. Ako su se SmokePing konfiguracija ili Cacti promijenili od ovog pregleda, uvoz se odbija i morate ponovo pokrenuti pregled."

#: lib/ImportPage.php
#, php-format
msgid "%s and %d more"
msgstr "%s i još %d"

#: lib/InventoryForms.php
#, php-format
msgid "Add %s to Cacti"
msgstr "Dodaj %s u Cacti"

#: lib/InventoryForms.php
#, php-format
msgid "SmokePing target %s (host %s) has no Cacti device. Choose what to do with it."
msgstr "SmokePing cilj %s (host %s) nema Cacti uređaj. Odaberite šta želite uraditi s njim."

#: lib/InventoryForms.php
msgid "Create a new device from the SmokePing Target template"
msgstr "Kreiraj novi uređaj iz šablona SmokePing Target"

#: lib/InventoryForms.php
msgid "Map it to an existing device"
msgstr "Mapiraj na postojeći uređaj"

#: lib/InventoryForms.php
msgid "Either way the target gets a summary graph for alerting and, when SmokePing's data can be graphed, a smoke graph. Cacti never writes SmokePing's files."
msgstr "U oba slučaja cilj dobija zbirni grafikon za alarme i, kada se SmokePing podaci mogu prikazati grafički, smoke grafikon. Cacti nikada ne mijenja datoteke SmokePinga."

#: lib/InventoryForms.php
msgid "Add"
msgstr "Dodaj"

#: lib/InventoryForms.php
msgid "Confirm Re-link"
msgstr "Potvrdi ponovno povezivanje"

#: lib/InventoryForms.php
#, php-format
msgid "SmokePing no longer lists %s. %s has the same host (%s) and probe (%s). SmokePing starts a new, empty file for a new path."
msgstr "SmokePing više ne navodi %s. Putanja %s ima isti host (%s) i sondu (%s). SmokePing započinje novu, praznu datoteku za novu putanju."

