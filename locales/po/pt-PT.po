msgstr "O último inventário falhou há %d segundos e o anterior continua a ser utilizado: %s"

#: lib/HealthCheck.php
#, php-format
msgid "The inventory listed %d targets %d seconds ago."
msgstr "O inventário listou %d alvos há %d segundos."

