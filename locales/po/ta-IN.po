#: lib/MountCheck.php
#, php-format
msgid "The SmokePing mount %s is reached through a symlink, which Cacti refuses. Use a read-only bind mount instead."
msgstr "SmokePing மவுண்ட் %s ஒரு symlink வழியாக அணுகப்படுகிறது, இதை Cacti நிராகரிக்கிறது. அதற்குப் பதிலாக படிக்க-மட்டும் bind mount ஐப் பயன்படுத்தவும்."

#: lib/MountCheck.php
msgid "Unable to read the mount table, so the mount could not be confirmed read-only."
msgstr "மவுண்ட் அட்டவணையைப் படிக்க முடியவில்லை, எனவே மவுண்ட் படிக்க-மட்டுமானது என உறுதிப்படுத்த முடியவில்லை."

#: lib/MountCheck.php
#, php-format
msgid "%s is on a read-only mount."
