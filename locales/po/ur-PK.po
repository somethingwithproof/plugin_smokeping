msgstr "SmokePing کنفیگریشن امپورٹ کریں"

#: lib/ImportPage.php
msgid "Configuration"
msgstr "ترتیبات"

#: lib/ImportPage.php
msgid "The configured SmokePing file is read with the files it includes, from its own directory. An uploaded file is read on its own: @include is not allowed in it."
msgstr "کنفیگر کی گئی SmokePing فائل کو اس کی اپنی ڈائریکٹری سے ان فائلوں سمیت پڑھا جاتا ہے جو اس میں شامل ہیں۔ اپ لوڈ کی گئی فائل کو تنہا پڑھا جاتا ہے: اس میں @include کی اجازت نہیں ہے۔"

#: lib/ImportPage.php
#, php-format
msgid "The configured file, %s"
msgstr "کنفیگر شدہ فائل، %s"

#: lib/ImportPage.php
msgid "An uploaded file, without @include"
msgstr "اپ لوڈ کردہ فائل، بغیر @include کے"

#: lib/ImportPage.php
msgid "Uploaded File"
msgstr "اپ لوڈ کردہ فائل"

#: lib/ImportPage.php
msgid "Only for an uploaded file: a SmokePing configuration of at most 4 MiB."
msgstr "صرف اپ لوڈ کردہ فائل کے لیے: زیادہ سے زیادہ 4 MiB کی SmokePing کنفیگریشن۔"

#: lib/ImportPage.php
msgid "Devices"
msgstr "ڈیوائسز"

#: lib/ImportPage.php
msgid "One device per SmokePing host groups targets that probe the same host. A device that already has the host name on the chosen poller is used instead of a new one."
msgstr "فی SmokePing ہوسٹ ایک ڈیوائس ان ٹارگٹس کو یکجا کرتی ہے جو ایک ہی ہوسٹ کو پروب کرتے ہیں۔ نئی ڈیوائس کے بجائے منتخب پولر پر پہلے سے موجود اس ہوسٹ نام والی ڈیوائس استعمال کی جاتی ہے۔"

#: lib/ImportPage.php
msgid "One device per SmokePing host"
msgstr "فی SmokePing ہوسٹ ایک ڈیوائس"

#: lib/ImportPage.php
msgid "One device per SmokePing target"
msgstr "فی SmokePing ٹارگٹ ایک ڈیوائس"

#: lib/ImportPage.php
msgid "Device Template"
msgstr "ڈیوائس ٹیمپلیٹ"

#: lib/ImportPage.php
msgid "The template of devices the import creates."
msgstr "ان ڈیوائسز کا ٹیمپلیٹ جو امپورٹ بناتا ہے۔"

#: lib/ImportPage.php
msgid "Poller"
msgstr "پولر"

#: lib/ImportPage.php
msgid "The poller of new devices. It must be the poller that runs the SmokePing reader, or their summary data sources get no data."
msgstr "نئی ڈیوائسز کا پولر۔ یہ وہی پولر ہونا چاہیے جو SmokePing ریڈر چلاتا ہے، ورنہ ان کے خلاصہ ڈیٹا سورسز کو کوئی ڈیٹا نہیں ملے گا۔"

