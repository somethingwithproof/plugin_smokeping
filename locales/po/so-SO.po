msgid "The reader read %d of %d series in %.1f seconds, %d seconds ago."
msgstr "Akhristuhu wuxuu akhriyay %d ka mid ah %d taxane %.1f ilbiriqsi gudahood, %d ilbiriqsi ka hor."

#: lib/HealthCheck.php
msgid "No inventory has been read on this poller."
msgstr "Wax diiwaan alaab ah lagama akhrin poller-kan."

#: lib/HealthCheck.php
#, php-format
msgid "The last inventory failed %d seconds ago and the previous one is still in use: %s"
msgstr "Diiwaankii ugu dambeeyay wuxuu ku guuldarraystay %d ilbiriqsi ka hor kii horena weli waa la isticmaalayaa: %s"

#: lib/HealthCheck.php
#, php-format
msgid "The inventory listed %d targets %d seconds ago."
msgstr "Diiwaanku wuxuu taxay %d bartilmaameed %d ilbiriqsi ka hor."

