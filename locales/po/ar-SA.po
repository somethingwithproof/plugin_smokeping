#, php-format
msgid "The last inventory failed %d seconds ago and the previous one is still in use: %s"
msgstr "فشل آخر جرد قبل %d ثانية ولا يزال الجرد السابق مستخدمًا: %s"

#: lib/HealthCheck.php
#, php-format
