msgstr "SmokePing konfigurāciju nevar nolasīt, tāpēc nekas netika importēts: %s"

#: smokeping_import.php
msgid "There is no previewed import to apply. Preview it again."
msgstr "Nav priekšskatīta importa, ko piemērot. Veiciet priekšskatījumu vēlreiz."

