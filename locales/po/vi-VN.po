#: lib/ConfigPage.php
msgid "XML"
msgstr "XML"

#: lib/ConfigPage.php
msgid "YAML (default)"
msgstr "YAML (mặc định)"

#: lib/ConfigPage.php lib/Pages.php
msgid "SmokePing Configuration"
msgstr "Cấu hình SmokePing"

#: lib/ConfigPage.php
msgid "Your device permissions do not cover every device, so you cannot export or import the SmokePing configuration. Ask an administrator with access to all devices."
msgstr "Quyền thiết bị của bạn không bao gồm mọi thiết bị, vì vậy bạn không thể xuất hoặc nhập cấu hình SmokePing. Hãy yêu cầu quản trị viên có quyền truy cập vào tất cả thiết bị."

#: lib/ConfigPage.php
msgid "Export the SmokePing Configuration"
msgstr "Xuất cấu hình SmokePing"

#: lib/ConfigPage.php
msgid "The export holds the plugin settings, the SmokePing targets the plugin has read, and which device each is mapped to, by the device's host name and description. It holds no data source, graph, RRD file, or credential."
msgstr "Bản xuất chứa cài đặt plugin, các mục tiêu SmokePing mà plugin đã đọc và thiết bị được ánh xạ tương ứng theo tên máy chủ và mô tả của thiết bị. Bản xuất không chứa nguồn dữ liệu, đồ thị, tệp RRD hoặc thông tin xác thực."

#: lib/ConfigPage.php
msgid "Download"
msgstr "Tải xuống"

#: lib/ConfigPage.php
msgid "Import a SmokePing Configuration"
msgstr "Nhập cấu hình SmokePing"

#: lib/ConfigPage.php
msgid "Choosing a file only checks it. The next screen lists every change the file would make, and nothing is written until you confirm that list. An import adds and updates; it never deletes a target or moves a mapping, and it never creates an RRD file or touches the SmokePing data directory."
msgstr "Việc chọn tệp chỉ để kiểm tra tệp đó. Màn hình tiếp theo sẽ liệt kê mọi thay đổi mà tệp sẽ thực hiện và không có gì được ghi cho đến khi bạn xác nhận danh sách đó. Thao tác nhập chỉ thêm mới và cập nhật; nó không bao giờ xóa mục tiêu hoặc di chuyển ánh xạ, và không bao giờ tạo tệp RRD hay tác động đến thư mục dữ liệu SmokePing."

#: lib/ConfigPage.php
msgid "Check File"
msgstr "Kiểm tra tệp"

#: lib/ConfigPage.php lib/ImportPage.php
msgid "Import Check"
msgstr "Kiểm tra nhập"

#: lib/ConfigPage.php
msgid "Nothing was written."
msgstr "Không có dữ liệu nào được ghi."

#: lib/ConfigPage.php lib/ImportPage.php smokeping_import.php
msgid "Back"
msgstr "Quay lại"

#: lib/ConfigPage.php
msgid "The file cannot be imported until these errors are fixed. Nothing was written."
msgstr "Không thể nhập tệp cho đến khi các lỗi này được khắc phục. Không có dữ liệu nào được ghi."

#: lib/ConfigPage.php
msgid "The installation already matches the file. There is nothing to import."
msgstr "Bản cài đặt hiện tại đã khớp với tệp. Không có gì để nhập."

#: lib/ConfigPage.php
#, php-format
msgid "Plan %s. Applying makes exactly these changes in one transaction. If the file or the installation changed since this check, the import is refused and you check again."
msgstr "Kế hoạch %s. Việc áp dụng sẽ thực hiện chính xác các thay đổi này trong một giao dịch. Nếu tệp hoặc bản cài đặt đã thay đổi kể từ lần kiểm tra này, việc nhập sẽ bị từ chối và bạn phải kiểm tra lại."

#: lib/ConfigPage.php
msgid "Apply Import"
msgstr "Áp dụng nhập"

#: lib/ConfigPage.php lib/ImportPage.php lib/InventoryForms.php
msgid "Cancel"
msgstr "Hủy"

#: lib/DeviceActions.php
msgid "Add SmokePing Targets"
msgstr "Thêm mục tiêu SmokePing"

#: lib/DeviceActions.php
msgid "no matching SmokePing target"
msgstr "không có mục tiêu SmokePing nào khớp"

#: lib/DeviceActions.php
msgid "Click Continue to add the SmokePing targets whose host is the host name of each selected device. Each target gets a summary graph for alerting and, when SmokePing's data can be graphed, a smoke graph. Devices are never created here."
msgstr "Nhấp vào Tiếp tục để thêm các mục tiêu SmokePing có máy chủ trùng với tên máy chủ của từng thiết bị đã chọn. Mỗi mục tiêu sẽ có một đồ thị tóm tắt để cảnh báo và một đồ thị smoke khi dữ liệu của SmokePing có thể vẽ được. Thiết bị không bao giờ được tạo tại đây."

#: lib/DeviceActions.php
#, php-format
msgid "%d targets match."
msgstr "%d mục tiêu khớp."

#: lib/DeviceActions.php
#, php-format
msgid "%d objects created or mapped, %d skipped."
msgstr "%d đối tượng đã được tạo hoặc ánh xạ, %d đã bỏ qua."

#: lib/DeviceSaveCheck.php
#, php-format
msgid "This device has SmokePing targets, but the reader that fills their summary values runs on poller %d and the device is saved on poller %d. Summary values and alerts stop until the device is assigned to poller %d again."
msgstr "Thiết bị này có các mục tiêu SmokePing, nhưng trình đọc điền giá trị tóm tắt của chúng chạy trên poller %d còn thiết bị được lưu trên poller %d. Các giá trị tóm tắt và cảnh báo sẽ dừng cho đến khi thiết bị được gán lại cho poller %d."

#: lib/GraphLinks.php
msgid "SmokePing Targets of this Device"
msgstr "Mục tiêu SmokePing của thiết bị này"

#: lib/HealthCheck.php
#, php-format
msgid "%d smoke graphs still draw the other colors; the main poller moves up to 200 per cycle."
msgstr "%d đồ thị smoke vẫn vẽ các màu khác; poller chính chuyển đổi tối đa 200 đồ thị mỗi chu kỳ."

#: lib/HealthCheck.php
#, php-format
msgid "%d smoke graphs could not be moved; run upgrade-graphs to try them again, and see the Cacti log for the cause."
msgstr "Không thể chuyển đổi %d đồ thị smoke; hãy chạy upgrade-graphs để thử lại và xem nhật ký Cacti để biết nguyên nhân."

#: lib/HealthCheck.php
#, php-format
msgid "The Loss Colors setting asks for SmokePing %s loss colors, but the reader found SmokePing %s. Set it to Automatic unless the graphs should differ from SmokePing's."
msgstr "Cài đặt Màu mất gói yêu cầu màu mất gói của SmokePing %s, nhưng trình đọc phát hiện SmokePing %s. Hãy đặt thành Tự động trừ khi các đồ thị cần hiển thị khác với SmokePing."

#: lib/HealthCheck.php
#, php-format
msgid "The Loss Colors setting selects SmokePing %s loss colors for smoke graphs."
msgstr "Cài đặt Màu mất gói chọn màu mất gói của SmokePing %s cho các đồ thị smoke."

#: lib/HealthCheck.php
msgid "The reader found no SmokePing version, so the Loss Colors setting selects the loss colors of SmokePing 2.8 and later. If SmokePing is 2.7, set Loss Colors to SmokePing 2.7."
msgstr "Trình đọc không tìm thấy phiên bản SmokePing, nên cài đặt Màu mất gói chọn màu mất gói của SmokePing 2.8 trở về sau. Nếu là SmokePing 2.7, hãy đặt Màu mất gói thành SmokePing 2.7."

#: lib/HealthCheck.php
#, php-format
msgid "The reader found SmokePing %s, so the Loss Colors setting selects its loss colors."
msgstr "Trình đọc phát hiện SmokePing %s, nên cài đặt Màu mất gói chọn màu mất gói của phiên bản đó."

#: lib/HealthCheck.php
msgid "Thold is not installed, so no target alerts in both SmokePing and Thold."
msgstr "Thold chưa được cài đặt, nên không có mục tiêu nào cảnh báo trên cả SmokePing và Thold."

#: lib/HealthCheck.php
msgid "No target has both a SmokePing alert and an enabled Thold threshold."
msgstr "Không có mục tiêu nào có cả cảnh báo SmokePing và ngưỡng Thold đang bật."

#: lib/HealthCheck.php
#, php-format
msgid "%d targets have both a SmokePing alert and an enabled Thold threshold, so one problem may notify twice. Compare their alert conditions before removing either: %s"
msgstr "%d mục tiêu có cả cảnh báo SmokePing và ngưỡng Thold đang bật, nên một sự cố có thể thông báo hai lần. Hãy so sánh điều kiện cảnh báo của chúng trước khi xóa một trong hai: %s"

#: lib/HealthCheck.php
#, php-format
msgid "The SmokePing templates failed to import and are not retried automatically: %s Use Retry Template Import after fixing the cause."
msgstr "Nhập các mẫu SmokePing thất bại và sẽ không tự động thử lại: %s Hãy dùng Nhập lại mẫu sau khi khắc phục nguyên nhân."

#: lib/HealthCheck.php
msgid "The SmokePing templates are not imported. Use Retry Template Import."
msgstr "Các mẫu SmokePing chưa được nhập. Hãy dùng Nhập lại mẫu."

#: lib/HealthCheck.php smokeping_health.php
msgid "The SmokePing templates are imported."
msgstr "Các mẫu SmokePing đã được nhập."

#: lib/HealthCheck.php
msgid "Every device with summary data sources is polled by the reader's poller."
msgstr "Mọi thiết bị có nguồn dữ liệu tóm tắt đều được thăm dò bởi poller của trình đọc."

#: lib/HealthCheck.php
#, php-format
msgid "%d devices have summary data sources but are not polled by poller %d, which runs the reader, so their summary values and alerts have no data: %s"
msgstr "%d thiết bị có nguồn dữ liệu tóm tắt nhưng không được thăm dò bởi poller %d (nơi chạy trình đọc), nên giá trị tóm tắt và cảnh báo của chúng không có dữ liệu: %s"

#: lib/HealthCheck.php
#, php-format
msgid "The SmokePing configuration is read on poller %d, not on this server; the inventory row shows the result of its last read."
msgstr "Cấu hình SmokePing được đọc trên poller %d, không phải trên máy chủ này; hàng kiểm kê hiển thị kết quả của lần đọc gần nhất."

#: lib/HealthCheck.php
#, php-format
msgid "The SmokePing configuration %s cannot be read: %s"
msgstr "Không thể đọc cấu hình SmokePing %s: %s"

#: lib/HealthCheck.php
#, php-format
msgid "The SmokePing configuration %s lists %d targets; %d entries are skipped: %s"
msgstr "Cấu hình SmokePing %s liệt kê %d mục tiêu; %d mục bị bỏ qua: %s"

#: lib/HealthCheck.php
#, php-format
msgid "The SmokePing configuration %s lists %d targets."
msgstr "Cấu hình SmokePing %s liệt kê %d mục tiêu."

#: lib/HealthCheck.php
msgid "The PHP binary path setting is empty or not an executable file, so the reader cannot start."
msgstr "Cài đặt đường dẫn tệp nhị phân PHP bị trống hoặc không phải là tệp thực thi, nên trình đọc không thể khởi động."

#: lib/HealthCheck.php
#, php-format
msgid "The reader starts with %s."
msgstr "Trình đọc khởi động bằng %s."

#: lib/HealthCheck.php
msgid "The reader has not completed a run on this poller."
msgstr "Trình đọc chưa hoàn thành lần chạy nào trên poller này."

#: lib/HealthCheck.php
#, php-format
msgid "The last reader run finished %d seconds ago, more than three poller intervals."
msgstr "Lần chạy trình đọc gần nhất đã kết thúc cách đây %d giây, vượt quá ba chu kỳ poller."

#: lib/HealthCheck.php
#, php-format
msgid "The reader read %d of %d series in %.1f seconds and has exceeded its time budget %d times."
msgstr "Trình đọc đã đọc %d trên %d chuỗi trong %.1f giây và đã vượt quá giới hạn thời gian %d lần."

#: lib/HealthCheck.php
#, php-format
msgid "The reader read %d of %d series in %.1f seconds, %d seconds ago."
msgstr "Trình đọc đã đọc %d trên %d chuỗi trong %.1f giây, cách đây %d giây."

#: lib/HealthCheck.php
msgid "No inventory has been read on this poller."
msgstr "Chưa có kiểm kê nào được đọc trên poller này."

#: lib/HealthCheck.php
#, php-format
msgid "The last inventory failed %d seconds ago and the previous one is still in use: %s"
msgstr "Lần kiểm kê gần nhất đã thất bại cách đây %d giây và bản kiểm kê trước đó vẫn đang được sử dụng: %s"

#: lib/HealthCheck.php
#, php-format
msgid "The inventory listed %d targets %d seconds ago."
msgstr "Bản kiểm kê đã liệt kê %d mục tiêu cách đây %d giây."

