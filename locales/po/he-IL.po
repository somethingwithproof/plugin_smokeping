#: lib/ImportPage.php lib/Pages.php
msgid "Import SmokePing Configuration"
msgstr "ייבוא תצורת SmokePing"

#: lib/ImportPage.php
msgid "Configuration"
msgstr "תצורה"

#: lib/ImportPage.php
msgid "The configured SmokePing file is read with the files it includes, from its own directory. An uploaded file is read on its own: @include is not allowed in it."
msgstr "קובץ SmokePing המוגדר נקרא יחד עם הקבצים שהוא כולל, מהספרייה שלו. קובץ שהועלה נקרא בפני עצמו: @include אינו מותר בו."

#: lib/ImportPage.php
#, php-format
msgid "The configured file, %s"
msgstr "הקובץ המוגדר, %s"

#: lib/ImportPage.php
msgid "An uploaded file, without @include"
msgstr "קובץ שהועלה, ללא @include"

#: lib/ImportPage.php
msgid "Uploaded File"
msgstr "קובץ שהועלה"

#: lib/ImportPage.php
msgid "Only for an uploaded file: a SmokePing configuration of at most 4 MiB."
msgstr "עבור קובץ שהועלה בלבד: תצורת SmokePing בגודל של לכל היותר 4 MiB."

#: lib/ImportPage.php
msgid "Devices"
msgstr "התקנים"

#: lib/ImportPage.php
msgid "One device per SmokePing host groups targets that probe the same host. A device that already has the host name on the chosen poller is used instead of a new one."
msgstr "התקן אחד לכל מארח SmokePing מקבץ יעדים הבודקים את אותו מארח. התקן שכבר יש לו את שם המארח בדוגם שנבחר ישמש במקום התקן חדש."

#: lib/ImportPage.php
msgid "One device per SmokePing host"
msgstr "התקן אחד לכל מארח SmokePing"

#: lib/ImportPage.php
msgid "One device per SmokePing target"
msgstr "התקן אחד לכל יעד SmokePing"

#: lib/ImportPage.php
msgid "Device Template"
msgstr "תבנית התקן"

#: lib/ImportPage.php
msgid "The template of devices the import creates."
msgstr "תבנית ההתקנים שהייבוא יוצר."

#: lib/ImportPage.php
msgid "Poller"
msgstr "דוגם"

#: lib/ImportPage.php
msgid "The poller of new devices. It must be the poller that runs the SmokePing reader, or their summary data sources get no data."
msgstr "הדוגם של התקנים חדשים. עליו להיות הדוגם שמריץ את קורא SmokePing, אחרת מקורות הנתונים המסכמים שלהם לא יקבלו נתונים."

#: lib/ImportPage.php
msgid "Site"
msgstr "אתר"

#: lib/ImportPage.php
msgid "The site of new devices."
msgstr "האתר של התקנים חדשים."

#: lib/ImportPage.php smokeping_inventory.php
msgid "None"
msgstr "ללא"

#: lib/ImportPage.php
msgid "Graph Tree"
msgstr "עץ גרפים"

#: lib/ImportPage.php
msgid "Mirror the SmokePing hierarchy into a graph tree: each section becomes a branch, and each device a host under the branch of its targets. Existing branches and hosts are reused."
msgstr "שקף את ההיררכיה של SmokePing לתוך עץ גרפים: כל מקטע הופך לענף, וכל התקן למארח תחת הענף של היעדים שלו. נעשה שימוש חוזר בענפים ובמארחים קיימים."

#: lib/ImportPage.php
msgid "A new tree, named below"
msgstr "עץ חדש, בשם שלהלן"

#: lib/ImportPage.php
msgid "Do not mirror"
msgstr "אל תשקף"

#: lib/ImportPage.php
msgid "New Tree Name"
msgstr "שם עץ חדש"

#: lib/ImportPage.php
msgid "Only for a new tree. A tree that already has this name is used."
msgstr "עבור עץ חדש בלבד. ייעשה שימוש בעץ שכבר נושא שם זה."

#: lib/ImportPage.php
msgid "Preview reads the configuration and lists what the import would create. Nothing is written until you confirm that list on the next screen, and SmokePing's own files are never written."
msgstr "התצוגה המקדימה קוראת את התצורה ומפרטת את מה שהייבוא ייצור. דבר אינו נכתב עד שתאשר רשימה זו במסך הבא, והקבצים של SmokePing עצמו אינם נכתבים לעולם."

#: lib/ImportPage.php
msgid "Preview"
msgstr "תצוגה מקדימה"

#: lib/ImportPage.php
msgid "Note"
msgstr "הערה"

#: lib/ImportPage.php
msgid "Level"
msgstr "רמה"

#: lib/ImportPage.php
