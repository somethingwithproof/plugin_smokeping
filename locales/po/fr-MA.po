#, php-format
msgid "%d devices have summary data sources but are not polled by poller %d, which runs the reader, so their summary values and alerts have no data: %s"
msgstr "%d appareils disposent de sources de données de synthèse mais ne sont pas interrogés par le collecteur %d, qui exécute le lecteur ; leurs valeurs de synthèse et alertes n'ont donc aucune donnée : %s"

#: lib/HealthCheck.php
#, php-format
msgid "The SmokePing configuration is read on poller %d, not on this server; the inventory row shows the result of its last read."
msgstr "La configuration SmokePing est lue sur le collecteur %d, et non sur ce serveur ; la ligne d'inventaire affiche le résultat de sa dernière lecture."

