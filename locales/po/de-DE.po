msgid "Every device with summary data sources is polled by the reader's poller."
msgstr "Jedes Zielsystem mit Zusammenfassungs-Datenquellen wird vom Poller des Readers abgefragt."

#: lib/HealthCheck.php
#, php-format
msgid "%d devices have summary data sources but are not polled by poller %d, which runs the reader, so their summary values and alerts have no data: %s"
msgstr "%d Zielsysteme haben Zusammenfassungs-Datenquellen, werden aber nicht von Poller %d abgefragt, der den Reader ausführt; ihre Zusammenfassungswerte und Alarme haben daher keine Daten: %s"

#: lib/HealthCheck.php
#, php-format
