#: lib/ImportPage.php
msgid "Configuration"
msgstr "Konfigurasi"

#: lib/ImportPage.php
msgid "The configured SmokePing file is read with the files it includes, from its own directory. An uploaded file is read on its own: @include is not allowed in it."
msgstr "Fail SmokePing yang dikonfigurasi dibaca bersama fail yang disertakannya daripada direktorinya sendiri. Fail yang dimuat naik dibaca secara berasingan: @include tidak dibenarkan di dalamnya."

#: lib/ImportPage.php
#, php-format
msgid "The configured file, %s"
msgstr "Fail yang dikonfigurasi, %s"

#: lib/ImportPage.php
msgid "An uploaded file, without @include"
msgstr "Fail yang dimuat naik, tanpa @include"

#: lib/ImportPage.php
msgid "Uploaded File"
msgstr "Fail Dimuat Naik"

#: lib/ImportPage.php
msgid "Only for an uploaded file: a SmokePing configuration of at most 4 MiB."
msgstr "Hanya untuk fail yang dimuat naik: konfigurasi SmokePing bersaiz maksimum 4 MiB."

#: lib/ImportPage.php
msgid "Devices"
msgstr "Peranti"

#: lib/ImportPage.php
msgid "One device per SmokePing host groups targets that probe the same host. A device that already has the host name on the chosen poller is used instead of a new one."
msgstr "Satu peranti bagi setiap hos SmokePing mengumpulkan sasaran yang menguji hos yang sama. Peranti yang sudah mempunyai nama hos tersebut pada poller yang dipilih akan digunakan dan bukannya mencipta yang baharu."

#: lib/ImportPage.php
msgid "One device per SmokePing host"
msgstr "Satu peranti bagi setiap hos SmokePing"

#: lib/ImportPage.php
msgid "One device per SmokePing target"
msgstr "Satu peranti bagi setiap sasaran SmokePing"

#: lib/ImportPage.php
