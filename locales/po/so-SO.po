#: lib/ImportPage.php
msgid "Uploaded File"
msgstr "Faylka la Soo geliyay"

#: lib/ImportPage.php
msgid "Only for an uploaded file: a SmokePing configuration of at most 4 MiB."
msgstr "Kaliya fayl la soo geliyay: dejinta SmokePing ee ugu badnaan 4 MiB."

#: lib/ImportPage.php
