#: include/operator.php lib/ViewPage.php
msgid "Master"
msgstr "ماسٹر"

#: include/operator.php
msgid "Compare loss and latency with the SmokePing graphs and maintenance state. Escalate missing files, imports and relinking to an administrator."
msgstr "نقصان اور لیٹنسی کا SmokePing گرافز اور دیکھ بھال کی حالت سے موازنہ کریں۔ گمشدہ فائلوں، امپورٹس اور دوبارہ لنک کرنے کے معاملات ایڈمنسٹریٹر کو بھیجیں۔"

#: lib/ActionOutcome.php
#, php-format
msgid "skipped, %s"
msgstr "چھوڑ دیا گیا، %s"

#: lib/ConfigPage.php
msgid "XML"
msgstr "XML"

#: lib/ConfigPage.php
msgid "YAML (default)"
msgstr "YAML (ڈیفالٹ)"

#: lib/ConfigPage.php lib/Pages.php
msgid "SmokePing Configuration"
msgstr "SmokePing کنفیگریشن"

#: lib/ConfigPage.php
msgid "Your device permissions do not cover every device, so you cannot export or import the SmokePing configuration. Ask an administrator with access to all devices."
msgstr "آپ کی ڈیوائس اجازتیں ہر ڈیوائس کو شامل نہیں کرتیں، اس لیے آپ SmokePing کنفیگریشن ایکسپورٹ یا امپورٹ نہیں کر سکتے۔ تمام ڈیوائسز تک رسائی رکھنے والے ایڈمنسٹریٹر سے درخواست کریں۔"

#: lib/ConfigPage.php
msgid "Export the SmokePing Configuration"
msgstr "SmokePing کنفیگریشن ایکسپورٹ کریں"

#: lib/ConfigPage.php
msgid "The export holds the plugin settings, the SmokePing targets the plugin has read, and which device each is mapped to, by the device's host name and description. It holds no data source, graph, RRD file, or credential."
msgstr "ایکسپورٹ میں پلگ ان کی ترتیبات، وہ SmokePing ٹارگٹس جو پلگ ان نے پڑھے ہیں، اور ڈیوائس کے ہوسٹ نام اور تفصیل کے ذریعے ہر ٹارگٹ کس ڈیوائس سے میپ کیا گیا ہے، شامل ہوتا ہے۔ اس میں کوئی ڈیٹا سورس، گراف، RRD فائل، یا اسناد شامل نہیں ہوتیں۔"

#: lib/ConfigPage.php
msgid "Download"
msgstr "ڈاؤن لوڈ کریں"

#: lib/ConfigPage.php
msgid "Import a SmokePing Configuration"
msgstr "SmokePing کنفیگریشن امپورٹ کریں"

#: lib/ConfigPage.php
msgid "Choosing a file only checks it. The next screen lists every change the file would make, and nothing is written until you confirm that list. An import adds and updates; it never deletes a target or moves a mapping, and it never creates an RRD file or touches the SmokePing data directory."
msgstr "فائل منتخب کرنے سے صرف اس کی جانچ ہوتی ہے۔ اگلی اسکرین پر ان تمام تبدیلیوں کی فہرست دکھائی جاتی ہے جو یہ فائل کرے گی، اور جب تک آپ اس فہرست کی تصدیق نہ کریں کچھ بھی تحریر نہیں کیا جاتا۔ امپورٹ صرف اضافہ اور اپ ڈیٹ کرتا ہے؛ یہ کبھی کسی ٹارگٹ کو حذف نہیں کرتا یا میپنگ کو منتقل نہیں کرتا، اور نہ ہی کوئی RRD فائل بناتا ہے یا SmokePing ڈیٹا ڈائریکٹری کو چھوتا ہے۔"

#: lib/ConfigPage.php
msgid "Check File"
msgstr "فائل چیک کریں"

#: lib/ConfigPage.php lib/ImportPage.php
msgid "Import Check"
msgstr "امپورٹ جانچ"

#: lib/ConfigPage.php
msgid "Nothing was written."
msgstr "کچھ بھی تحریر نہیں کیا گیا۔"

#: lib/ConfigPage.php lib/ImportPage.php smokeping_import.php
msgid "Back"
msgstr "واپس"

#: lib/ConfigPage.php
msgid "The file cannot be imported until these errors are fixed. Nothing was written."
msgstr "جب تک یہ خرابیاں درست نہیں ہو جاتیں فائل امپورٹ نہیں کی جا سکتی۔ کچھ بھی تحریر نہیں کیا گیا۔"

#: lib/ConfigPage.php
msgid "The installation already matches the file. There is nothing to import."
msgstr "انسٹالیشن پہلے ہی فائل سے مطابقت رکھتی ہے۔ امپورٹ کرنے کے لیے کچھ نہیں ہے۔"

#: lib/ConfigPage.php
#, php-format
msgid "Plan %s. Applying makes exactly these changes in one transaction. If the file or the installation changed since this check, the import is refused and you check again."
msgstr "منصوبہ %s۔ لاگو کرنے سے ایک ہی ٹرانزیکشن میں بالکل یہی تبدیلیاں کی جاتی ہیں۔ اگر اس جانچ کے بعد فائل یا انسٹالیشن میں کوئی تبدیلی ہوئی تو امپورٹ مسترد کر دی جائے گی اور آپ کو دوبارہ جانچ کرنی ہوگی۔"

#: lib/ConfigPage.php
msgid "Apply Import"
msgstr "امپورٹ لاگو کریں"

#: lib/ConfigPage.php lib/ImportPage.php lib/InventoryForms.php
msgid "Cancel"
msgstr "منسوخ کریں"

#: lib/DeviceActions.php
msgid "Add SmokePing Targets"
msgstr "SmokePing ٹارگٹس شامل کریں"

#: lib/DeviceActions.php
msgid "no matching SmokePing target"
msgstr "کوئی مماثل SmokePing ٹارگٹ نہیں"

#: lib/DeviceActions.php
msgid "Click Continue to add the SmokePing targets whose host is the host name of each selected device. Each target gets a summary graph for alerting and, when SmokePing's data can be graphed, a smoke graph. Devices are never created here."
msgstr "ان SmokePing ٹارگٹس کو شامل کرنے کے لیے جاری رکھیں پر کلک کریں جن کا ہوسٹ ہر منتخب ڈیوائس کا ہوسٹ نام ہے۔ ہر ٹارگٹ کو الرٹنگ کے لیے ایک خلاصہ گراف ملتا ہے اور، جب SmokePing کا ڈیٹا گراف کیا جا سکے، ایک اسموک گراف ملتا ہے۔ یہاں ڈیوائسز کبھی نہیں بنائی جاتیں۔"

#: lib/DeviceActions.php
#, php-format
msgid "%d targets match."
msgstr "%d ٹارگٹس مماثل ہیں۔"

#: lib/DeviceActions.php
#, php-format
msgid "%d objects created or mapped, %d skipped."
msgstr "%d آبجیکٹس بنائے یا میپ کیے گئے، %d چھوڑ دیے گئے۔"

#: lib/DeviceSaveCheck.php
#, php-format
msgid "This device has SmokePing targets, but the reader that fills their summary values runs on poller %d and the device is saved on poller %d. Summary values and alerts stop until the device is assigned to poller %d again."
msgstr "اس ڈیوائس میں SmokePing ٹارگٹس ہیں، لیکن ان کی خلاصہ قدریں بھرنے والا ریڈر پولر %d پر چلتا ہے اور ڈیوائس پولر %d پر محفوظ ہے۔ خلاصہ قدریں اور الرٹس اس وقت تک رک جائیں گے جب تک ڈیوائس کو دوبارہ پولر %d کو تفویض نہ کیا جائے۔"

#: lib/GraphLinks.php
msgid "SmokePing Targets of this Device"
msgstr "اس ڈیوائس کے SmokePing ٹارگٹس"

#: lib/HealthCheck.php
#, php-format
msgid "%d smoke graphs still draw the other colors; the main poller moves up to 200 per cycle."
msgstr "%d اسموک گرافز اب بھی دوسرے رنگ دکھا رہے ہیں؛ مرکزی پولر فی سائیکل 200 تک منتقل کرتا ہے۔"

#: lib/HealthCheck.php
#, php-format
msgid "%d smoke graphs could not be moved; run upgrade-graphs to try them again, and see the Cacti log for the cause."
msgstr "%d اسموک گرافز منتقل نہیں ہو سکے؛ انہیں دوبارہ آزمانے کے لیے upgrade-graphs چلائیں، اور وجہ جاننے کے لیے Cacti لاگ دیکھیں۔"

#: lib/HealthCheck.php
#, php-format
msgid "The Loss Colors setting asks for SmokePing %s loss colors, but the reader found SmokePing %s. Set it to Automatic unless the graphs should differ from SmokePing's."
msgstr "Loss Colors ترتیب SmokePing %s کے نقصان کے رنگوں کا تقاضا کرتی ہے، لیکن ریڈر کو SmokePing %s ملا۔ جب تک گرافز کو SmokePing سے مختلف نہ ہونا ہو، اسے خودکار پر سیٹ کریں۔"

#: lib/HealthCheck.php
#, php-format
msgid "The Loss Colors setting selects SmokePing %s loss colors for smoke graphs."
msgstr "Loss Colors ترتیب اسموک گرافز کے لیے SmokePing %s کے نقصان کے رنگ منتخب کرتی ہے۔"

#: lib/HealthCheck.php
msgid "The reader found no SmokePing version, so the Loss Colors setting selects the loss colors of SmokePing 2.8 and later. If SmokePing is 2.7, set Loss Colors to SmokePing 2.7."
msgstr "ریڈر کو SmokePing کا کوئی ورژن نہیں ملا، اس لیے Loss Colors ترتیب SmokePing 2.8 اور اس کے بعد کے ورژنز کے نقصان کے رنگ منتخب کرتی ہے۔ اگر SmokePing 2.7 ہے تو Loss Colors کو SmokePing 2.7 پر سیٹ کریں۔"

#: lib/HealthCheck.php
#, php-format
msgid "The reader found SmokePing %s, so the Loss Colors setting selects its loss colors."
msgstr "ریڈر کو SmokePing %s ملا، اس لیے Loss Colors ترتیب اسی کے نقصان کے رنگ منتخب کرتی ہے۔"

#: lib/HealthCheck.php
msgid "Thold is not installed, so no target alerts in both SmokePing and Thold."
msgstr "Thold انسٹال نہیں ہے، اس لیے کوئی ٹارگٹ SmokePing اور Thold دونوں میں الرٹ نہیں کرتا۔"

#: lib/HealthCheck.php
msgid "No target has both a SmokePing alert and an enabled Thold threshold."
msgstr "کسی ٹارگٹ میں SmokePing الرٹ اور فعال Thold حد دونوں نہیں ہیں۔"

#: lib/HealthCheck.php
#, php-format
msgid "%d targets have both a SmokePing alert and an enabled Thold threshold, so one problem may notify twice. Compare their alert conditions before removing either: %s"
msgstr "%d ٹارگٹس میں SmokePing الرٹ اور فعال Thold حد دونوں ہیں، اس لیے ایک مسئلہ دو بار اطلاع دے سکتا ہے۔ کسی ایک کو ہٹانے سے پہلے ان کی الرٹ شرائط کا موازنہ کریں: %s"

#: lib/HealthCheck.php
#, php-format
msgid "The SmokePing templates failed to import and are not retried automatically: %s Use Retry Template Import after fixing the cause."
msgstr "SmokePing ٹیمپلیٹس امپورٹ ہونے میں ناکام رہے اور خودکار طور پر دوبارہ کوشش نہیں کی جاتی: %s وجہ درست کرنے کے بعد ٹیمپلیٹ امپورٹ دوبارہ آزمائیں استعمال کریں۔"

#: lib/HealthCheck.php
msgid "The SmokePing templates are not imported. Use Retry Template Import."
msgstr "SmokePing ٹیمپلیٹس امپورٹ نہیں ہوئے ہیں۔ ٹیمپلیٹ امپورٹ دوبارہ آزمائیں استعمال کریں۔"

#: lib/HealthCheck.php smokeping_health.php
msgid "The SmokePing templates are imported."
msgstr "SmokePing ٹیمپلیٹس امپورٹ ہو چکے ہیں۔"

#: lib/HealthCheck.php
msgid "Every device with summary data sources is polled by the reader's poller."
msgstr "خلاصہ ڈیٹا سورسز والی ہر ڈیوائس کو ریڈر کے پولر کے ذریعے پول کیا جاتا ہے۔"

#: lib/HealthCheck.php
#, php-format
msgid "%d devices have summary data sources but are not polled by poller %d, which runs the reader, so their summary values and alerts have no data: %s"
msgstr "%d ڈیوائسز میں خلاصہ ڈیٹا سورسز موجود ہیں لیکن انہیں پولر %d کے ذریعے پول نہیں کیا جا رہا جو ریڈر چلاتا ہے، اس لیے ان کی خلاصہ قدروں اور الرٹس کے پاس کوئی ڈیٹا نہیں ہے: %s"

#: lib/HealthCheck.php
#, php-format
msgid "The SmokePing configuration is read on poller %d, not on this server; the inventory row shows the result of its last read."
msgstr "SmokePing کنفیگریشن اس سرور پر نہیں بلکہ پولر %d پر پڑھی جاتی ہے؛ انوینٹری کی قطار اس کی آخری ریڈ کا نتیجہ دکھاتی ہے۔"

#: lib/HealthCheck.php
#, php-format
msgid "The SmokePing configuration %s cannot be read: %s"
msgstr "SmokePing کنفیگریشن %s پڑھی نہیں جا سکتی: %s"

#: lib/HealthCheck.php
#, php-format
msgid "The SmokePing configuration %s lists %d targets; %d entries are skipped: %s"
msgstr "SmokePing کنفیگریشن %s میں %d ٹارگٹس درج ہیں؛ %d اندراجات چھوڑ دیے گئے: %s"

#: lib/HealthCheck.php
#, php-format
msgid "The SmokePing configuration %s lists %d targets."
msgstr "SmokePing کنفیگریشن %s میں %d ٹارگٹس درج ہیں۔"

#: lib/HealthCheck.php
msgid "The PHP binary path setting is empty or not an executable file, so the reader cannot start."
msgstr "PHP بائنری پاتھ کی ترتیب خالی ہے یا قابلِ عمل فائل نہیں ہے، اس لیے ریڈر شروع نہیں ہو سکتا۔"

#: lib/HealthCheck.php
#, php-format
msgid "The reader starts with %s."
msgstr "ریڈر %s کے ساتھ شروع ہوتا ہے۔"

#: lib/HealthCheck.php
msgid "The reader has not completed a run on this poller."
msgstr "ریڈر نے اس پولر پر کوئی رن مکمل نہیں کیا ہے۔"

#: lib/HealthCheck.php
#, php-format
msgid "The last reader run finished %d seconds ago, more than three poller intervals."
msgstr "ریڈر کا آخری رن %d سیکنڈ پہلے مکمل ہوا، جو تین پولر وقفوں سے زیادہ ہے۔"

#: lib/HealthCheck.php
#, php-format
msgid "The reader read %d of %d series in %.1f seconds and has exceeded its time budget %d times."
msgstr "ریڈر نے %d سیریز (کل %d میں سے) %.1f سیکنڈز میں پڑھیں اور %d مرتبہ اپنے مقررہ وقت کی حد سے تجاوز کیا۔"

#: lib/HealthCheck.php
#, php-format
msgid "The reader read %d of %d series in %.1f seconds, %d seconds ago."
msgstr "ریڈر نے %d سیریز (کل %d میں سے) %.1f سیکنڈز میں پڑھیں، %d سیکنڈ پہلے۔"

#: lib/HealthCheck.php
msgid "No inventory has been read on this poller."
msgstr "اس پولر پر کوئی انوینٹری نہیں پڑھی گئی ہے۔"

#: lib/HealthCheck.php
#, php-format
msgid "The last inventory failed %d seconds ago and the previous one is still in use: %s"
msgstr "آخری انوینٹری %d سیکنڈ پہلے ناکام ہوئی اور پچھلی اب بھی زیرِ استعمال ہے: %s"

#: lib/HealthCheck.php
#, php-format
msgid "The inventory listed %d targets %d seconds ago."
msgstr "انوینٹری نے %d ٹارگٹس %d سیکنڈ پہلے درج کیے۔"

