#: lib/InventoryForms.php
#, php-format
msgid "SmokePing target %s (host %s) has no Cacti device. Choose what to do with it."
msgstr "Sasaran SmokePing %s (hos %s) tidak mempunyai peranti Cacti. Pilih tindakan untuknya."

#: lib/InventoryForms.php
msgid "Create a new device from the SmokePing Target template"
msgstr "Cipta peranti baharu daripada templat SmokePing Target"

#: lib/InventoryForms.php
msgid "Map it to an existing device"
msgstr "Petakannya kepada peranti sedia ada"

#: lib/InventoryForms.php
msgid "Either way the target gets a summary graph for alerting and, when SmokePing's data can be graphed, a smoke graph. Cacti never writes SmokePing's files."
msgstr "Walau bagaimanapun, sasaran akan mendapat graf ringkasan untuk pemakluman dan, apabila data SmokePing boleh digrafkan, graf smoke. Cacti tidak pernah menulis fail SmokePing."

#: lib/InventoryForms.php
msgid "Add"
msgstr "Tambah"

#: lib/InventoryForms.php
msgid "Confirm Re-link"
