msgstr "Імпортувати"

#: lib/ImportPage.php
msgid "Section"
msgstr "Розділ"

#: lib/ImportPage.php
msgid "Targets"
msgstr "Цілі"

#: lib/ImportPage.php
msgid "No section is checked, so every target is selected. Check sections and update the preview to import only those."
msgstr "Жоден розділ не позначено, тому вибрано всі цілі. Позначте розділи та оновіть попередній перегляд, щоб імпортувати лише їх."

#: lib/ImportPage.php
msgid "Only targets in the checked sections are selected."
msgstr "Вибрано лише цілі у позначених розділах."

#: lib/ImportPage.php
msgid "Update Preview"
msgstr "Оновити попередній перегляд"

