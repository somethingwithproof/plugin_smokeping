#: smokeping_config.php smokeping_import.php
msgid "No file was uploaded, or it is larger than the server accepts."
msgstr "Не беше качен файл или размерът му надвишава допустимия от сървъра."

#: smokeping_config.php
msgid "There is no checked import to apply. Check the file again."
msgstr "Няма проверено импортиране за прилагане. Проверете файла отново."

#: smokeping_config.php
msgid "The configuration was imported."
msgstr "Конфигурацията беше импортирана."

#: smokeping_health.php
msgid "The SmokePing templates failed to import. See the health table."
msgstr "Шаблоните на SmokePing не успяха да се импортират. Вижте таблицата за състояние."

#: smokeping_import.php
msgid "Your device permissions do not cover every device, so you cannot import a SmokePing configuration. Ask an administrator with access to all devices."
msgstr "Правата ви за устройства не покриват всички устройства, затова не можете да импортирате конфигурация на SmokePing. Помолете администратор с достъп до всички устройства."

#: smokeping_import.php
msgid "Name the new graph tree, or choose an existing tree or no tree."
msgstr "Въведете име на новото дърво с графики или изберете съществуващо дърво или без дърво."

#: smokeping_import.php
msgid "The uploaded file is larger than 4 MiB."
msgstr "Каченият файл е по-голям от 4 MiB."

#: smokeping_import.php
#, php-format
msgid "The SmokePing configuration cannot be read, so nothing was imported: %s"
msgstr "Конфигурацията на SmokePing не може да бъде прочетена, затова нищо не беше импортирано: %s"

#: smokeping_import.php
msgid "There is no previewed import to apply. Preview it again."
msgstr "Няма прегледано импортиране за прилагане. Направете предварителен преглед отново."

#: smokeping_import.php
#, php-format
msgid "and %d more; see the Cacti log"
msgstr "и още %d; вижте журнала на Cacti"

#: smokeping_import.php
msgid "The SmokePing configuration was imported."
msgstr "Конфигурацията на SmokePing беше импортирана."

#: smokeping_inventory.php
msgid "Choose a target on this poller and, to map it, a device you may change."
msgstr "Изберете цел на този полър и, за да я съпоставите, устройство, което имате право да променяте."

#: smokeping_inventory.php
msgid "The proposal is not open, or it involves a device or poller you may not change."
msgstr "Предложението не е отворено или засяга устройство или полър, които нямате право да променяте."

#: smokeping_inventory.php
msgid "The proposal was dismissed."
msgstr "Предложението беше отхвърлено."

