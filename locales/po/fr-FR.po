#: lib/ImportPage.php
msgid "Configuration"
msgstr "Configuration"

#: lib/ImportPage.php
msgid "The configured SmokePing file is read with the files it includes, from its own directory. An uploaded file is read on its own: @include is not allowed in it."
msgstr "Le fichier SmokePing configuré est lu avec les fichiers qu'il inclut, depuis son propre répertoire. Un fichier téléversé est lu seul : @include n'y est pas autorisé."

#: lib/ImportPage.php
#, php-format
msgid "The configured file, %s"
msgstr "Le fichier configuré, %s"

#: lib/ImportPage.php
msgid "An uploaded file, without @include"
msgstr "Un fichier téléversé, sans @include"

#: lib/ImportPage.php
msgid "Uploaded File"
msgstr "Fichier téléversé"

#: lib/ImportPage.php
msgid "Only for an uploaded file: a SmokePing configuration of at most 4 MiB."
msgstr "Uniquement pour un fichier téléversé : une configuration SmokePing de 4 MiB au maximum."

#: lib/ImportPage.php
msgid "Devices"
msgstr "Équipements"

#: lib/ImportPage.php
msgid "One device per SmokePing host groups targets that probe the same host. A device that already has the host name on the chosen poller is used instead of a new one."
msgstr "Un équipement par hôte SmokePing regroupe les cibles qui sondent le même hôte. Un équipement qui porte déjà ce nom d'hôte sur l'agent de collecte choisi est utilisé à la place d'un nouvel équipement."

#: lib/ImportPage.php
msgid "One device per SmokePing host"
msgstr "Un équipement par hôte SmokePing"

#: lib/ImportPage.php
msgid "One device per SmokePing target"
msgstr "Un équipement par cible SmokePing"

