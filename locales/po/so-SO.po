msgstr "Dejinta SmokePing %s lama akhrin karo: %s"

#: lib/HealthCheck.php
#, php-format
msgid "The SmokePing configuration %s lists %d targets; %d entries are skipped: %s"
msgstr "Dejinta SmokePing %s waxay taxdaa %d bartilmaameed; %d gelitaan waa la dhaafay: %s"

#: lib/HealthCheck.php
#, php-format
msgid "The SmokePing configuration %s lists %d targets."
msgstr "Dejinta SmokePing %s waxay taxdaa %d bartilmaameed."

#: lib/HealthCheck.php
msgid "The PHP binary path setting is empty or not an executable file, so the reader cannot start."
msgstr "Dejinta jidka faylka PHP way madhan tahay ama maaha fayl la fulin karo, markaa akhristuhu ma bilaabi karo."

#: lib/HealthCheck.php
#, php-format
msgid "The reader starts with %s."
msgstr "Akhristuhu wuxuu ku bilaabmaa %s."

#: lib/HealthCheck.php
msgid "The reader has not completed a run on this poller."
msgstr "Akhristuhu ma dhammaystirin orod poller-kan."

#: lib/HealthCheck.php
#, php-format
msgid "The last reader run finished %d seconds ago, more than three poller intervals."
msgstr "Orodkii ugu dambeeyay ee akhristuhu wuxuu dhammaaday %d ilbiriqsi ka hor, taas oo ka badan saddex jeer muddada poller-ka."

#: lib/HealthCheck.php
#, php-format
msgid "The reader read %d of %d series in %.1f seconds and has exceeded its time budget %d times."
msgstr "Akhristuhu wuxuu akhriyay %d ka mid ah %d taxane %.1f ilbiriqsi gudahood wuxuuna dhaafay miisaaniyadda waqtigiisa %d jeer."

#: lib/HealthCheck.php
