* text=auto eol=lf
*.rrd binary

# `git archive` and GitHub's automatic "Source code" archives leave out what a
# site does not run, so they hold the same files as the release archive.
# tools/make-release.sh's allowlist is the policy; tests/archive-policy-test.sh
# fails when the two disagree. Documentation stays in.
/.editorconfig export-ignore
/.gitattributes export-ignore
/.github export-ignore
/CODE_OF_CONDUCT.md export-ignore
/CONTRIBUTING.md export-ignore
/locales/build_gettext.sh export-ignore
/phpstan.neon export-ignore
/phpunit*.xml export-ignore
/tests export-ignore
/tools export-ignore
