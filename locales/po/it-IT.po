msgstr "Master"

#: include/operator.php
msgid "Compare loss and latency with the SmokePing graphs and maintenance state. Escalate missing files, imports and relinking to an administrator."
msgstr "Confrontare perdita e latenza con i grafici SmokePing e lo stato di manutenzione. Segnalare file mancanti, importazioni e ricollegamenti a un amministratore."

#: lib/ActionOutcome.php
#, php-format
msgid "skipped, %s"
msgstr "ignorato, %s"

