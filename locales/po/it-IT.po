msgstr "Il file configurato, %s"

#: lib/ImportPage.php
msgid "An uploaded file, without @include"
msgstr "Un file caricato, senza @include"

#: lib/ImportPage.php
msgid "Uploaded File"
msgstr "File caricato"

#: lib/ImportPage.php
msgid "Only for an uploaded file: a SmokePing configuration of at most 4 MiB."
msgstr "Solo per un file caricato: una configurazione SmokePing di al massimo 4 MiB."

#: lib/ImportPage.php
msgid "Devices"
msgstr "Dispositivi"

#: lib/ImportPage.php
msgid "One device per SmokePing host groups targets that probe the same host. A device that already has the host name on the chosen poller is used instead of a new one."
msgstr "Un dispositivo per host SmokePing raggruppa i target che sondano lo stesso host. Un dispositivo già presente con quel nome host sul poller scelto viene utilizzato al posto di uno nuovo."

#: lib/ImportPage.php
msgid "One device per SmokePing host"
msgstr "Un dispositivo per host SmokePing"

#: lib/ImportPage.php
msgid "One device per SmokePing target"
msgstr "Un dispositivo per target SmokePing"

