msgstr "Den senaste inläsningskörningen avslutades för %d sekunder sedan, vilket är mer än tre pollerintervall."

#: lib/HealthCheck.php
#, php-format
msgid "The reader read %d of %d series in %.1f seconds and has exceeded its time budget %d times."
msgstr "Inläsaren läste %d av %d serier på %.1f sekunder och har överskridit sin tidsbudget %d gånger."

#: lib/HealthCheck.php
#, php-format
msgid "The reader read %d of %d series in %.1f seconds, %d seconds ago."
msgstr "Inläsaren läste %d av %d serier på %.1f sekunder, för %d sekunder sedan."

#: lib/HealthCheck.php
msgid "No inventory has been read on this poller."
msgstr "Ingen inventering har lästs in på denna poller."

#: lib/HealthCheck.php
#, php-format
msgid "The last inventory failed %d seconds ago and the previous one is still in use: %s"
msgstr "Den senaste inventeringen misslyckades för %d sekunder sedan och den föregående används fortfarande: %s"

#: lib/HealthCheck.php
#, php-format
msgid "The inventory listed %d targets %d seconds ago."
msgstr "Inventeringen listade %d mål för %d sekunder sedan."

