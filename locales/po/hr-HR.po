msgstr "Nema provjerenog uvoza za primjenu. Ponovno provjerite datoteku."

#: smokeping_config.php
msgid "The configuration was imported."
msgstr "Konfiguracija je uvezena."

#: smokeping_health.php
msgid "The SmokePing templates failed to import. See the health table."
msgstr "Uvoz predložaka SmokePinga nije uspio. Pogledajte tablicu ispravnosti."

#: smokeping_import.php
msgid "Your device permissions do not cover every device, so you cannot import a SmokePing configuration. Ask an administrator with access to all devices."
msgstr "Vaše ovlasti za uređaje ne obuhvaćaju sve uređaje pa ne možete uvesti konfiguraciju SmokePinga. Obratite se administratoru s pristupom svim uređajima."

#: smokeping_import.php
msgid "Name the new graph tree, or choose an existing tree or no tree."
msgstr "Zadajte naziv novog stabla grafova ili odaberite postojeće stablo odnosno bez stabla."

#: smokeping_import.php
msgid "The uploaded file is larger than 4 MiB."
msgstr "Prenesena datoteka veća je od 4 MiB."

#: smokeping_import.php
#, php-format
msgid "The SmokePing configuration cannot be read, so nothing was imported: %s"
msgstr "Konfiguraciju SmokePinga nije moguće očitati pa ništa nije uvezeno: %s"

#: smokeping_import.php
msgid "There is no previewed import to apply. Preview it again."
msgstr "Nema pretpregledanog uvoza za primjenu. Ponovite pretpregled."

#: smokeping_import.php
#, php-format
msgid "and %d more; see the Cacti log"
msgstr "i još %d; pogledajte dnevnik sustava Cacti"

#: smokeping_import.php
msgid "The SmokePing configuration was imported."
msgstr "Konfiguracija SmokePinga je uvezena."

#: smokeping_inventory.php
msgid "Choose a target on this poller and, to map it, a device you may change."
msgstr "Odaberite cilj na ovom polleru i, za pridruživanje, uređaj koji smijete mijenjati."

#: smokeping_inventory.php
msgid "The proposal is not open, or it involves a device or poller you may not change."
msgstr "Prijedlog nije otvoren ili obuhvaća uređaj odnosno poller koji ne smijete mijenjati."

#: smokeping_inventory.php
msgid "The proposal was dismissed."
msgstr "Prijedlog je odbačen."

