#: lib/ImportPage.php
msgid "Uploaded File"
msgstr "Hochgeladene Datei"

#: lib/ImportPage.php
msgid "Only for an uploaded file: a SmokePing configuration of at most 4 MiB."
msgstr "Nur für eine hochgeladene Datei: eine SmokePing-Konfiguration von höchstens 4 MiB."

#: lib/ImportPage.php
msgid "Devices"
msgstr "Zielsysteme"

#: lib/ImportPage.php
msgid "One device per SmokePing host groups targets that probe the same host. A device that already has the host name on the chosen poller is used instead of a new one."
msgstr "Ein Zielsystem pro SmokePing-Host fasst Ziele zusammen, die denselben Host prüfen. Ein Zielsystem, das den Hostnamen auf dem gewählten Poller bereits hat, wird anstelle eines neuen verwendet."

#: lib/ImportPage.php
msgid "One device per SmokePing host"
msgstr "Ein Zielsystem pro SmokePing-Host"

#: lib/ImportPage.php
msgid "One device per SmokePing target"
msgstr "Ein Zielsystem pro SmokePing-Ziel"

