#: smokeping_config.php smokeping_import.php
msgid "No file was uploaded, or it is larger than the server accepts."
msgstr "Fayl lama soo gelin, ama wuu ka weyn yahay inta adeeguhu aqbalo."

#: smokeping_config.php
msgid "There is no checked import to apply. Check the file again."
msgstr "Ma jirto soo-dejin la hubiyay oo la dabaqo. Mar kale hubi faylka."

#: smokeping_config.php
msgid "The configuration was imported."
msgstr "Dejinta waa la soo dejiyay."

#: smokeping_health.php
msgid "The SmokePing templates failed to import. See the health table."
msgstr "Qaab-dhismeedyada SmokePing way ku guuldarraysteen in la soo dejiyo. Eeg miiska caafimaadka."

#: smokeping_import.php
msgid "Your device permissions do not cover every device, so you cannot import a SmokePing configuration. Ask an administrator with access to all devices."
msgstr "Ogolaanshahaaga qalabku ma daboolaan qalab kasta, sidaas darteed ma soo dejin kartid dejinta SmokePing. Weydii maamule leh gelitaanka dhammaan qalabyada."

#: smokeping_import.php
msgid "Name the new graph tree, or choose an existing tree or no tree."
msgstr "Magacaw geedka garaafyada cusub, ama dooro geed jira ama wax geed ah ha dooran."

#: smokeping_import.php
msgid "The uploaded file is larger than 4 MiB."
msgstr "Faylka la soo geliyay wuxuu ka weyn yahay 4 MiB."

#: smokeping_import.php
#, php-format
msgid "The SmokePing configuration cannot be read, so nothing was imported: %s"
msgstr "Dejinta SmokePing lama akhrin karo, sidaas darteed waxba lama soo dejin: %s"

#: smokeping_import.php
msgid "There is no previewed import to apply. Preview it again."
msgstr "Ma jirto soo-dejin horay loo eegay oo la dabaqo. Mar kale horay u eeg."

#: smokeping_import.php
#, php-format
msgid "and %d more; see the Cacti log"
msgstr "iyo %d kale; eeg diiwaanka Cacti"

#: smokeping_import.php
msgid "The SmokePing configuration was imported."
msgstr "Dejinta SmokePing waa la soo dejiyay."

#: smokeping_inventory.php
msgid "Choose a target on this poller and, to map it, a device you may change."
msgstr "Dooro bartilmaameed ku jira poller-kan iyo, si aad u meelayso, qalab aad beddeli karto."

#: smokeping_inventory.php
msgid "The proposal is not open, or it involves a device or poller you may not change."
msgstr "Soo-jeedintu ma furna, ama waxay ku lug leedahay qalab ama poller aadan beddeli karin."

#: smokeping_inventory.php
msgid "The proposal was dismissed."
msgstr "Soo-jeedinta waa la iska diiday."

