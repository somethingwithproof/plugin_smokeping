msgstr "На този полър не е прочетен инвентар."

#: lib/HealthCheck.php
#, php-format
msgid "The last inventory failed %d seconds ago and the previous one is still in use: %s"
msgstr "Последното инвентаризиране се провали преди %d секунди и все още се използва предишното: %s"

#: lib/HealthCheck.php
#, php-format
msgid "The inventory listed %d targets %d seconds ago."
msgstr "Инвентарът отчете %d цели преди %d секунди."

