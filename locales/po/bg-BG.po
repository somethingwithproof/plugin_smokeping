#, php-format
msgid "The reader starts with %s."
msgstr "Четецът стартира с %s."

#: lib/HealthCheck.php
msgid "The reader has not completed a run on this poller."
msgstr "Четецът не е завършил нито едно изпълнение на този полър."

#: lib/HealthCheck.php
#, php-format
msgid "The last reader run finished %d seconds ago, more than three poller intervals."
msgstr "Последното изпълнение на четеца завърши преди %d секунди, повече от три интервала на полъра."

#: lib/HealthCheck.php
#, php-format
msgid "The reader read %d of %d series in %.1f seconds and has exceeded its time budget %d times."
msgstr "Четецът прочете %d от %d серии за %.1f секунди и е надвишил времевия си бюджет %d пъти."

#: lib/HealthCheck.php
