msgstr "Impossibile leggere la configurazione SmokePing %s: %s"

#: lib/HealthCheck.php
#, php-format
msgid "The SmokePing configuration %s lists %d targets; %d entries are skipped: %s"
msgstr "La configurazione SmokePing %s elenca %d target; %d voci sono state ignorate: %s"

#: lib/HealthCheck.php
#, php-format
msgid "The SmokePing configuration %s lists %d targets."
msgstr "La configurazione SmokePing %s elenca %d target."

#: lib/HealthCheck.php
msgid "The PHP binary path setting is empty or not an executable file, so the reader cannot start."
msgstr "L'impostazione del percorso del binario PHP è vuota o non è un file eseguibile, quindi il lettore non può avviarsi."

