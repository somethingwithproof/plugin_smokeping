msgstr "Vaše dozvole za uređaje ne pokrivaju sve uređaje, pa ne možete uvesti SmokePing konfiguraciju. Obratite se administratoru koji ima pristup svim uređajima."

#: smokeping_import.php
msgid "Name the new graph tree, or choose an existing tree or no tree."
msgstr "Unesite ime novog stabla grafikona ili odaberite postojeće stablo ili opciju bez stabla."

#: smokeping_import.php
msgid "The uploaded file is larger than 4 MiB."
msgstr "Otpremljena datoteka je veća od 4 MiB."

#: smokeping_import.php
#, php-format
msgid "The SmokePing configuration cannot be read, so nothing was imported: %s"
msgstr "SmokePing konfiguracija se ne može pročitati, pa ništa nije uvezeno: %s"

#: smokeping_import.php
msgid "There is no previewed import to apply. Preview it again."
msgstr "Nema pregledanog uvoza za primjenu. Pokrenite pregled ponovo."

#: smokeping_import.php
#, php-format
msgid "and %d more; see the Cacti log"
msgstr "i još %d; pogledajte Cacti zapisnik"

#: smokeping_import.php
msgid "The SmokePing configuration was imported."
msgstr "SmokePing konfiguracija je uvezena."

#: smokeping_inventory.php
msgid "Choose a target on this poller and, to map it, a device you may change."
msgstr "Odaberite cilj na ovom polleru i, za mapiranje, uređaj koji smijete mijenjati."

#: smokeping_inventory.php
msgid "The proposal is not open, or it involves a device or poller you may not change."
msgstr "Prijedlog nije otvoren ili uključuje uređaj ili poller koji ne smijete mijenjati."

#: smokeping_inventory.php
msgid "The proposal was dismissed."
msgstr "Prijedlog je odbačen."

#: smokeping_operator.php
msgid "Monitoring view"
msgstr "Pregled praćenja"

#: smokeping_operator.php
msgid "Observations could not be read. Ask an administrator to check the plugin log."
msgstr "Zapažanja nisu mogla biti pročitana. Zamolite administratora da provjeri zapisnik dodatka."
