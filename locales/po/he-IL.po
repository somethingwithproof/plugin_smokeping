#: include/operator.php lib/ViewPage.php
msgid "Master"
msgstr "ראשי"

#: include/operator.php
msgid "Compare loss and latency with the SmokePing graphs and maintenance state. Escalate missing files, imports and relinking to an administrator."
msgstr "השווה את אובדן החבילות וההשהיה מול גרפי SmokePing ומצב התחזוקה. העבר קבצים חסרים, ייבואים וקישור מחדש לטיפול מנהל מערכת."

#: lib/ActionOutcome.php
#, php-format
msgid "skipped, %s"
msgstr "דולג, %s"

#: lib/ConfigPage.php
msgid "XML"
msgstr "XML"

#: lib/ConfigPage.php
msgid "YAML (default)"
msgstr "YAML (ברירת מחדל)"

#: lib/ConfigPage.php lib/Pages.php
msgid "SmokePing Configuration"
msgstr "תצורת SmokePing"

#: lib/ConfigPage.php
msgid "Your device permissions do not cover every device, so you cannot export or import the SmokePing configuration. Ask an administrator with access to all devices."
msgstr "הרשאות ההתקנים שלך אינן מכסות את כל ההתקנים, ולכן אינך יכול לייצא או לייבא את תצורת SmokePing. פנה למנהל מערכת בעל גישה לכל ההתקנים."

#: lib/ConfigPage.php
msgid "Export the SmokePing Configuration"
msgstr "ייצוא תצורת SmokePing"

#: lib/ConfigPage.php
msgid "The export holds the plugin settings, the SmokePing targets the plugin has read, and which device each is mapped to, by the device's host name and description. It holds no data source, graph, RRD file, or credential."
msgstr "הייצוא כולל את הגדרות התוסף, את יעדי SmokePing שהתוסף קרא, ואת ההתקן שאליו כל יעד ממופה לפי שם המארח והתיאור של ההתקן. הוא אינו כולל מקור נתונים, גרף, קובץ RRD או פרטי אימות."

#: lib/ConfigPage.php
msgid "Download"
msgstr "הורדה"

#: lib/ConfigPage.php
msgid "Import a SmokePing Configuration"
msgstr "ייבוא תצורת SmokePing"

#: lib/ConfigPage.php
msgid "Choosing a file only checks it. The next screen lists every change the file would make, and nothing is written until you confirm that list. An import adds and updates; it never deletes a target or moves a mapping, and it never creates an RRD file or touches the SmokePing data directory."
msgstr "בחירת קובץ רק בודקת אותו. המסך הבא מציג את כל השינויים שהקובץ יבצע, ודבר אינו נכתב עד שתאשר רשימה זו. ייבוא מוסיף ומעדכן; הוא לעולם אינו מוחק יעד או מעביר מיפוי, ולעולם אינו יוצר קובץ RRD או נוגע בספריית הנתונים של SmokePing."

#: lib/ConfigPage.php
msgid "Check File"
msgstr "בדוק קובץ"

#: lib/ConfigPage.php lib/ImportPage.php
msgid "Import Check"
msgstr "בדיקת ייבוא"

#: lib/ConfigPage.php
msgid "Nothing was written."
msgstr "דבר לא נכתב."

#: lib/ConfigPage.php lib/ImportPage.php smokeping_import.php
msgid "Back"
msgstr "חזרה"

#: lib/ConfigPage.php
msgid "The file cannot be imported until these errors are fixed. Nothing was written."
msgstr "לא ניתן לייבא את הקובץ עד ששגיאות אלה יתוקנו. דבר לא נכתב."

#: lib/ConfigPage.php
msgid "The installation already matches the file. There is nothing to import."
msgstr "ההתקנה כבר תואמת לקובץ. אין מה לייבא."

#: lib/ConfigPage.php
#, php-format
msgid "Plan %s. Applying makes exactly these changes in one transaction. If the file or the installation changed since this check, the import is refused and you check again."
msgstr "תוכנית %s. ההחלה מבצעת בדיוק שינויים אלה בטרנזקציה אחת. אם הקובץ או ההתקנה השתנו מאז בדיקה זו, הייבוא יידחה ותצטרך לבדוק שוב."

#: lib/ConfigPage.php
msgid "Apply Import"
msgstr "החל ייבוא"

#: lib/ConfigPage.php lib/ImportPage.php lib/InventoryForms.php
msgid "Cancel"
msgstr "ביטול"

#: lib/DeviceActions.php
msgid "Add SmokePing Targets"
msgstr "הוסף יעדי SmokePing"

#: lib/DeviceActions.php
msgid "no matching SmokePing target"
msgstr "אין יעד SmokePing תואם"

#: lib/DeviceActions.php
msgid "Click Continue to add the SmokePing targets whose host is the host name of each selected device. Each target gets a summary graph for alerting and, when SmokePing's data can be graphed, a smoke graph. Devices are never created here."
msgstr "לחץ על המשך כדי להוסיף את יעדי SmokePing שהמארח שלהם הוא שם המארח של כל התקן שנבחר. כל יעד מקבל גרף סיכום להתראות, וכאשר ניתן להציג את נתוני SmokePing בגרף, גם גרף עשן. התקנים אינם נוצרים כאן לעולם."

#: lib/DeviceActions.php
#, php-format
msgid "%d targets match."
msgstr "%d יעדים תואמים."

#: lib/DeviceActions.php
#, php-format
msgid "%d objects created or mapped, %d skipped."
msgstr "%d אובייקטים נוצרו או מופו, %d דולגו."

#: lib/DeviceSaveCheck.php
#, php-format
msgid "This device has SmokePing targets, but the reader that fills their summary values runs on poller %d and the device is saved on poller %d. Summary values and alerts stop until the device is assigned to poller %d again."
msgstr "להתקן זה יש יעדי SmokePing, אך הקורא שממלא את ערכי הסיכום שלהם פועל בדוגם %d וההתקן שמור בדוגם %d. ערכי הסיכום וההתראות ייעצרו עד שההתקן יוקצה שוב לדוגם %d."

#: lib/GraphLinks.php
msgid "SmokePing Targets of this Device"
msgstr "יעדי SmokePing של התקן זה"

#: lib/HealthCheck.php
#, php-format
msgid "%d smoke graphs still draw the other colors; the main poller moves up to 200 per cycle."
msgstr "%d גרפי עשן עדיין מציירים את הצבעים האחרים; הדוגם הראשי מעביר עד 200 בכל מחזור."

#: lib/HealthCheck.php
#, php-format
msgid "%d smoke graphs could not be moved; run upgrade-graphs to try them again, and see the Cacti log for the cause."
msgstr "לא ניתן היה להעביר %d גרפי עשן; הרץ את upgrade-graphs כדי לנסות שוב, ועיין ביומן Cacti לבירור הסיבה."

#: lib/HealthCheck.php
#, php-format
msgid "The Loss Colors setting asks for SmokePing %s loss colors, but the reader found SmokePing %s. Set it to Automatic unless the graphs should differ from SmokePing's."
msgstr "הגדרת צבעי האובדן מבקשת צבעי אובדן של SmokePing %s, אך הקורא מצא את SmokePing %s. הגדר אותה לאוטומטי אלא אם הגרפים אמורים להיות שונים מאלה של SmokePing."

#: lib/HealthCheck.php
#, php-format
msgid "The Loss Colors setting selects SmokePing %s loss colors for smoke graphs."
msgstr "הגדרת צבעי האובדן בוחרת בצבעי האובדן של SmokePing %s עבור גרפי עשן."

#: lib/HealthCheck.php
msgid "The reader found no SmokePing version, so the Loss Colors setting selects the loss colors of SmokePing 2.8 and later. If SmokePing is 2.7, set Loss Colors to SmokePing 2.7."
msgstr "הקורא לא מצא גרסת SmokePing, ולכן הגדרת צבעי האובדן בוחרת בצבעי האובדן של SmokePing 2.8 ומעלה. אם גרסת SmokePing היא 2.7, הגדר את צבעי האובדן ל-SmokePing 2.7."

#: lib/HealthCheck.php
#, php-format
msgid "The reader found SmokePing %s, so the Loss Colors setting selects its loss colors."
msgstr "הקורא מצא את SmokePing %s, ולכן הגדרת צבעי האובדן בוחרת בצבעי האובדן שלו."

#: lib/HealthCheck.php
msgid "Thold is not installed, so no target alerts in both SmokePing and Thold."
msgstr "Thold אינו מותקן, ולכן אף יעד אינו מתריע הן ב-SmokePing והן ב-Thold."

#: lib/HealthCheck.php
msgid "No target has both a SmokePing alert and an enabled Thold threshold."
msgstr "לאף יעד אין גם התראת SmokePing וגם סף Thold מופעל."

#: lib/HealthCheck.php
#, php-format
msgid "%d targets have both a SmokePing alert and an enabled Thold threshold, so one problem may notify twice. Compare their alert conditions before removing either: %s"
msgstr "ל-%d יעדים יש גם התראת SmokePing וגם סף Thold מופעל, ולכן בעיה אחת עלולה לשלוח התראה פעמיים. השווה את תנאי ההתראה שלהם לפני הסרת אחד מהם: %s"

#: lib/HealthCheck.php
#, php-format
msgid "The SmokePing templates failed to import and are not retried automatically: %s Use Retry Template Import after fixing the cause."
msgstr "ייבוא תבניות SmokePing נכשל ואינו מנוסה שוב אוטומטית: %s השתמש באפשרות נסה שוב לייבא תבניות לאחר תיקון הסיבה."

#: lib/HealthCheck.php
msgid "The SmokePing templates are not imported. Use Retry Template Import."
msgstr "תבניות SmokePing אינן מיובאות. השתמש באפשרות נסה שוב לייבא תבניות."

#: lib/HealthCheck.php smokeping_health.php
msgid "The SmokePing templates are imported."
msgstr "תבניות SmokePing מיובאות."

#: lib/HealthCheck.php
msgid "Every device with summary data sources is polled by the reader's poller."
msgstr "כל התקן עם מקורות נתונים מסכמים נדגם על ידי הדוגם של הקורא."

#: lib/HealthCheck.php
#, php-format
msgid "%d devices have summary data sources but are not polled by poller %d, which runs the reader, so their summary values and alerts have no data: %s"
msgstr "ל-%d התקנים יש מקורות נתונים מסכמים אך הם אינם נדגמים על ידי דוגם %d, שמריץ את הקורא, ולכן לערכי הסיכום ולהתראות שלהם אין נתונים: %s"

#: lib/HealthCheck.php
#, php-format
msgid "The SmokePing configuration is read on poller %d, not on this server; the inventory row shows the result of its last read."
msgstr "תצורת SmokePing נקראת בדוגם %d, לא בשרת זה; שורת המלאי מציגה את תוצאת הקריאה האחרונה שלו."

#: lib/HealthCheck.php
#, php-format
msgid "The SmokePing configuration %s cannot be read: %s"
msgstr "לא ניתן לקרוא את תצורת SmokePing %s: %s"

#: lib/HealthCheck.php
#, php-format
msgid "The SmokePing configuration %s lists %d targets; %d entries are skipped: %s"
msgstr "תצורת SmokePing %s מפרטת %d יעדים; %d רשומות דולגו: %s"

#: lib/HealthCheck.php
#, php-format
msgid "The SmokePing configuration %s lists %d targets."
msgstr "תצורת SmokePing %s מפרטת %d יעדים."

#: lib/HealthCheck.php
msgid "The PHP binary path setting is empty or not an executable file, so the reader cannot start."
msgstr "הגדרת נתיב הקובץ הבינארי של PHP ריקה או שאינה קובץ בר-הרצה, ולכן הקורא אינו יכול לפעול."

#: lib/HealthCheck.php
#, php-format
msgid "The reader starts with %s."
msgstr "הקורא מתחיל עם %s."

#: lib/HealthCheck.php
msgid "The reader has not completed a run on this poller."
msgstr "הקורא טרם השלים הרצה בדוגם זה."

#: lib/HealthCheck.php
#, php-format
msgid "The last reader run finished %d seconds ago, more than three poller intervals."
msgstr "הרצת הקורא האחרונה הסתיימה לפני %d שניות, יותר משלושה מרווחי דגימה."

#: lib/HealthCheck.php
#, php-format
msgid "The reader read %d of %d series in %.1f seconds and has exceeded its time budget %d times."
msgstr "הקורא קרא %d מתוך %d סדרות ב-%.1f שניות וחרג מתקציב הזמן שלו %d פעמים."

#: lib/HealthCheck.php
#, php-format
msgid "The reader read %d of %d series in %.1f seconds, %d seconds ago."
msgstr "הקורא קרא %d מתוך %d סדרות ב-%.1f שניות, לפני %d שניות."

#: lib/HealthCheck.php
msgid "No inventory has been read on this poller."
msgstr "לא נקרא מלאי בדוגם זה."

#: lib/HealthCheck.php
#, php-format
msgid "The last inventory failed %d seconds ago and the previous one is still in use: %s"
msgstr "המלאי האחרון נכשל לפני %d שניות והקודם עדיין בשימוש: %s"

#: lib/HealthCheck.php
#, php-format
msgid "The inventory listed %d targets %d seconds ago."
msgstr "המלאי פירט %d יעדים לפני %d שניות."

#: lib/HealthPage.php
#, php-format
msgid "SmokePing Health for Poller %d"
msgstr "תקינות SmokePing עבור דוגם %d"

#: lib/HealthPage.php
msgid "Check"
msgstr "בדיקה"

#: lib/HealthPage.php
msgid "Detail"
msgstr "פירוט"

#: lib/HealthPage.php
msgid "Status"
msgstr "מצב"

#: lib/HealthPage.php
msgid "Retry Template Import"
msgstr "נסה שוב לייבא תבניות"

