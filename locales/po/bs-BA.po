#: lib/ImportPage.php lib/Pages.php
msgid "Import SmokePing Configuration"
msgstr "Uvezi SmokePing konfiguraciju"

#: lib/ImportPage.php
msgid "Configuration"
msgstr "Konfiguracija"

#: lib/ImportPage.php
msgid "The configured SmokePing file is read with the files it includes, from its own directory. An uploaded file is read on its own: @include is not allowed in it."
msgstr "Konfigurisana SmokePing datoteka se čita zajedno s datotekama koje uključuje iz vlastitog direktorija. Otpremljena datoteka se čita samostalno: @include u njoj nije dozvoljen."

#: lib/ImportPage.php
#, php-format
msgid "The configured file, %s"
msgstr "Konfigurisana datoteka, %s"

#: lib/ImportPage.php
msgid "An uploaded file, without @include"
msgstr "Otpremljena datoteka, bez @include"

#: lib/ImportPage.php
msgid "Uploaded File"
msgstr "Otpremljena datoteka"

#: lib/ImportPage.php
msgid "Only for an uploaded file: a SmokePing configuration of at most 4 MiB."
msgstr "Samo za otpremljenu datoteku: SmokePing konfiguracija veličine najviše 4 MiB."

#: lib/ImportPage.php
msgid "Devices"
msgstr "Uređaji"

#: lib/ImportPage.php
msgid "One device per SmokePing host groups targets that probe the same host. A device that already has the host name on the chosen poller is used instead of a new one."
msgstr "Opcija jedan uređaj po SmokePing hostu grupiše ciljeve koji ispituju isti host. Uređaj koji već ima to ime hosta na odabranom polleru koristi se umjesto kreiranja novog."

#: lib/ImportPage.php
msgid "One device per SmokePing host"
msgstr "Jedan uređaj po SmokePing hostu"

#: lib/ImportPage.php
msgid "One device per SmokePing target"
msgstr "Jedan uređaj po SmokePing cilju"

#: lib/ImportPage.php
msgid "Device Template"
msgstr "Šablon uređaja"

#: lib/ImportPage.php
msgid "The template of devices the import creates."
msgstr "Šablon uređaja koje uvoz kreira."

#: lib/ImportPage.php
msgid "Poller"
msgstr "Poller"

#: lib/ImportPage.php
msgid "The poller of new devices. It must be the poller that runs the SmokePing reader, or their summary data sources get no data."
msgstr "Poller za nove uređaje. To mora biti poller na kojem radi SmokePing čitač, inače njihovi zbirni izvori podataka neće dobijati podatke."

#: lib/ImportPage.php
msgid "Site"
msgstr "Lokacija"

#: lib/ImportPage.php
msgid "The site of new devices."
msgstr "Lokacija novih uređaja."

#: lib/ImportPage.php smokeping_inventory.php
msgid "None"
msgstr "Nijedno"

#: lib/ImportPage.php
msgid "Graph Tree"
msgstr "Stablo grafikona"

#: lib/ImportPage.php
msgid "Mirror the SmokePing hierarchy into a graph tree: each section becomes a branch, and each device a host under the branch of its targets. Existing branches and hosts are reused."
msgstr "Preslikaj hijerarhiju SmokePinga u stablo grafikona: svaka sekcija postaje grana, a svaki uređaj postaje host pod granom svojih ciljeva. Postojeće grane i hostovi se ponovo koriste."

#: lib/ImportPage.php
msgid "A new tree, named below"
msgstr "Novo stablo, s imenom navedenim ispod"

#: lib/ImportPage.php
msgid "Do not mirror"
msgstr "Ne preslikavaj"

#: lib/ImportPage.php
msgid "New Tree Name"
msgstr "Ime novog stabla"

#: lib/ImportPage.php
msgid "Only for a new tree. A tree that already has this name is used."
msgstr "Samo za novo stablo. Koristi se stablo koje već ima ovo ime."

#: lib/ImportPage.php
msgid "Preview reads the configuration and lists what the import would create. Nothing is written until you confirm that list on the next screen, and SmokePing's own files are never written."
msgstr "Pregled čita konfiguraciju i prikazuje spisak onoga što bi uvoz kreirao. Ništa se ne upisuje dok ne potvrdite taj spisak na sljedećem ekranu, a vlastite datoteke SmokePinga se nikada ne mijenjaju."

#: lib/ImportPage.php
msgid "Preview"
msgstr "Pregled"

#: lib/ImportPage.php
msgid "Note"
msgstr "Napomena"

#: lib/ImportPage.php
