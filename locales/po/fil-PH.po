#: lib/ImportPage.php
msgid "Configuration"
msgstr "Configuration"

#: lib/ImportPage.php
msgid "The configured SmokePing file is read with the files it includes, from its own directory. An uploaded file is read on its own: @include is not allowed in it."
msgstr "Binabasa ang naka-configure na file ng SmokePing kasama ang mga file na isinasama nito, mula sa sarili nitong direktoryo. Binabasa nang mag-isa ang na-upload na file: hindi pinapayagan dito ang @include."

#: lib/ImportPage.php
#, php-format
msgid "The configured file, %s"
msgstr "Ang naka-configure na file, %s"

#: lib/ImportPage.php
msgid "An uploaded file, without @include"
msgstr "Isang na-upload na file, walang @include"

#: lib/ImportPage.php
msgid "Uploaded File"
msgstr "Na-upload na File"

#: lib/ImportPage.php
msgid "Only for an uploaded file: a SmokePing configuration of at most 4 MiB."
msgstr "Para lamang sa isang na-upload na file: isang configuration ng SmokePing na hindi hihigit sa 4 MiB."

#: lib/ImportPage.php
msgid "Devices"
msgstr "Mga Device"

#: lib/ImportPage.php
msgid "One device per SmokePing host groups targets that probe the same host. A device that already has the host name on the chosen poller is used instead of a new one."
msgstr "Pinapangkat ng isang kagamitan bawat host ng SmokePing ang mga target na sumusuri sa parehong host. Gagamitin ang isang kagamitan na mayroon nang host name sa napiling poller sa halip na bago."

#: lib/ImportPage.php
msgid "One device per SmokePing host"
msgstr "Isang kagamitan bawat host ng SmokePing"

#: lib/ImportPage.php
msgid "One device per SmokePing target"
msgstr "Isang kagamitan bawat target ng SmokePing"

#: lib/ImportPage.php
msgid "Device Template"
msgstr "Template ng Kagamitan"

#: lib/ImportPage.php
msgid "The template of devices the import creates."
msgstr "Ang template ng mga kagamitang gagawin ng pag-import."

#: lib/ImportPage.php
msgid "Poller"
msgstr "Poller"

#: lib/ImportPage.php
msgid "The poller of new devices. It must be the poller that runs the SmokePing reader, or their summary data sources get no data."
msgstr "Ang poller ng mga bagong kagamitan. Dapat ito ang poller na nagpapatakbo sa reader ng SmokePing, kung hindi ay walang makukuhang data ang kanilang mga summary data source."

#: lib/ImportPage.php
msgid "Site"
msgstr "Site"

#: lib/ImportPage.php
msgid "The site of new devices."
msgstr "Ang site ng mga bagong kagamitan."

#: lib/ImportPage.php smokeping_inventory.php
