#, php-format
msgid "The SmokePing configuration %s cannot be read: %s"
msgstr "Konfigurasi SmokePing %s tidak dapat dibaca: %s"

#: lib/HealthCheck.php
#, php-format
msgid "The SmokePing configuration %s lists %d targets; %d entries are skipped: %s"
msgstr "Konfigurasi SmokePing %s mencantumkan %d target; %d entri dilewati: %s"

#: lib/HealthCheck.php
#, php-format
msgid "The SmokePing configuration %s lists %d targets."
msgstr "Konfigurasi SmokePing %s mencantumkan %d target."

#: lib/HealthCheck.php
msgid "The PHP binary path setting is empty or not an executable file, so the reader cannot start."
msgstr "Pengaturan jalur biner PHP kosong atau bukan berkas yang dapat dieksekusi, sehingga pembaca tidak dapat dimulai."

#: lib/HealthCheck.php
#, php-format
msgid "The reader starts with %s."
msgstr "Pembaca dimulai dengan %s."

#: lib/HealthCheck.php
msgid "The reader has not completed a run on this poller."
msgstr "Pembaca belum menyelesaikan satu kali eksekusi pada poller ini."

#: lib/HealthCheck.php
#, php-format
msgid "The last reader run finished %d seconds ago, more than three poller intervals."
msgstr "Eksekusi pembaca terakhir selesai %d detik yang lalu, lebih dari tiga interval poller."

#: lib/HealthCheck.php
#, php-format
msgid "The reader read %d of %d series in %.1f seconds and has exceeded its time budget %d times."
msgstr "Pembaca membaca %d dari %d deret dalam %.1f detik dan telah melampaui batas waktunya sebanyak %d kali."

#: lib/HealthCheck.php
#, php-format
msgid "The reader read %d of %d series in %.1f seconds, %d seconds ago."
msgstr "Pembaca membaca %d dari %d deret dalam %.1f detik, %d detik yang lalu."

#: lib/HealthCheck.php
msgid "No inventory has been read on this poller."
msgstr "Belum ada inventaris yang dibaca pada poller ini."

#: lib/HealthCheck.php
#, php-format
msgid "The last inventory failed %d seconds ago and the previous one is still in use: %s"
msgstr "Inventaris terakhir gagal %d detik yang lalu dan inventaris sebelumnya masih digunakan: %s"

#: lib/HealthCheck.php
#, php-format
msgid "The inventory listed %d targets %d seconds ago."
msgstr "Inventaris mencantumkan %d target %d detik yang lalu."

