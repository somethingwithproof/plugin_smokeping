msgstr "L'ultima esecuzione del lettore è terminata %d secondi fa, più di tre intervalli del poller."

#: lib/HealthCheck.php
#, php-format
msgid "The reader read %d of %d series in %.1f seconds and has exceeded its time budget %d times."
msgstr "Il lettore ha letto %d di %d serie in %.1f secondi e ha superato il tempo limite %d volte."

#: lib/HealthCheck.php
#, php-format
msgid "The reader read %d of %d series in %.1f seconds, %d seconds ago."
msgstr "Il lettore ha letto %d di %d serie in %.1f secondi, %d secondi fa."

#: lib/HealthCheck.php
msgid "No inventory has been read on this poller."
msgstr "Nessun inventario è stato letto su questo poller."

#: lib/HealthCheck.php
#, php-format
msgid "The last inventory failed %d seconds ago and the previous one is still in use: %s"
msgstr "L'ultimo inventario non è riuscito %d secondi fa e il precedente è ancora in uso: %s"

#: lib/HealthCheck.php
#, php-format
msgid "The inventory listed %d targets %d seconds ago."
msgstr "L'inventario ha elencato %d target %d secondi fa."

