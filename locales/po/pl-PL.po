msgstr "Wtyczka SmokePing wymaga PHP w wersji %s lub nowszej. Ten serwer używa PHP %s, więc wtyczka nie została zainstalowana ani włączona."

#: setup.php
msgid "The SmokePing plugin is not enabled."
msgstr "Wtyczka SmokePing nie jest włączona."

#: setup.php
#, php-format
msgid "The SmokePing plugin requires PHP %s or later."
msgstr "Wtyczka SmokePing wymaga PHP w wersji %s lub nowszej."

#: setup.php
#, php-format
msgid "The SmokePing configuration was exported to %s"
msgstr "Konfiguracja SmokePing została wyeksportowana do %s"

#: setup.php
msgid "The SmokePing configuration was not exported; see the SmokePing log. The uninstall went ahead."
msgstr "Konfiguracja SmokePing nie została wyeksportowana; zobacz dziennik SmokePing. Deinstalacja była kontynuowana."

#: setup.php
msgid "Management"
msgstr "Zarządzanie"

#: setup.php
msgid "Import/Export"
msgstr "Import/Eksport"

#: setup.php
msgid "You do not have permission to add SmokePing targets."
msgstr "Nie masz uprawnień do dodawania celów SmokePing."

#: smokeping_config.php smokeping_import.php
msgid "No file was uploaded, or it is larger than the server accepts."
msgstr "Nie przesłano żadnego pliku lub jest on większy niż akceptowany przez serwer."

#: smokeping_config.php
msgid "There is no checked import to apply. Check the file again."
msgstr "Brak sprawdzonego importu do zastosowania. Sprawdź plik ponownie."

#: smokeping_config.php
msgid "The configuration was imported."
msgstr "Konfiguracja została zaimportowana."

#: smokeping_health.php
msgid "The SmokePing templates failed to import. See the health table."
msgstr "Nie udało się zaimportować szablonów SmokePing. Zobacz tabelę kondycji."

#: smokeping_import.php
msgid "Your device permissions do not cover every device, so you cannot import a SmokePing configuration. Ask an administrator with access to all devices."
msgstr "Twoje uprawnienia do urządzeń nie obejmują wszystkich urządzeń, więc nie możesz zaimportować konfiguracji SmokePing. Poproś administratora z dostępem do wszystkich urządzeń."

#: smokeping_import.php
msgid "Name the new graph tree, or choose an existing tree or no tree."
msgstr "Nazwij nowe drzewo wykresów albo wybierz istniejące drzewo lub brak drzewa."

#: smokeping_import.php
msgid "The uploaded file is larger than 4 MiB."
msgstr "Przesłany plik jest większy niż 4 MiB."

#: smokeping_import.php
#, php-format
msgid "The SmokePing configuration cannot be read, so nothing was imported: %s"
msgstr "Nie można odczytać konfiguracji SmokePing, więc nic nie zostało zaimportowane: %s"

#: smokeping_import.php
msgid "There is no previewed import to apply. Preview it again."
msgstr "Brak podglądu importu do zastosowania. Wyświetl podgląd ponownie."

#: smokeping_import.php
#, php-format
msgid "and %d more; see the Cacti log"
msgstr "i jeszcze %d; zobacz dziennik Cacti"

#: smokeping_import.php
msgid "The SmokePing configuration was imported."
msgstr "Konfiguracja została zaimportowana."

#: smokeping_inventory.php
msgid "Choose a target on this poller and, to map it, a device you may change."
msgstr "Wybierz cel na tym pollerze oraz, aby go zmapować, urządzenie, które możesz modyfikować."

#: smokeping_inventory.php
msgid "The proposal is not open, or it involves a device or poller you may not change."
msgstr "Propozycja nie jest otwarta albo dotyczy urządzenia lub pollera, którego nie możesz modyfikować."

#: smokeping_inventory.php
msgid "The proposal was dismissed."
msgstr "Propozycja została odrzucona."

#: smokeping_operator.php
msgid "Monitoring view"
msgstr "Widok monitorowania"

#: smokeping_operator.php
msgid "Observations could not be read. Ask an administrator to check the plugin log."
msgstr "Nie można odczytać obserwacji. Poproś administratora o sprawdzenie dziennika wtyczki."
