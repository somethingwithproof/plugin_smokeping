msgid "Every device with summary data sources is polled by the reader's poller."
msgstr "Всяко устройство с обобщени източници на данни се запитва от полъра на четеца."

#: lib/HealthCheck.php
#, php-format
msgid "%d devices have summary data sources but are not polled by poller %d, which runs the reader, so their summary values and alerts have no data: %s"
msgstr "%d устройства имат обобщени източници на данни, но не се запитват от полър %d, на който работи четецът, така че техните обобщени стойности и известия нямат данни: %s"

#: lib/HealthCheck.php
#, php-format
msgid "The SmokePing configuration is read on poller %d, not on this server; the inventory row shows the result of its last read."
msgstr "Конфигурацията на SmokePing се чете на полър %d, а не на този сървър; редът за инвентара показва резултата от последното прочитане."

#: lib/HealthCheck.php
#, php-format
msgid "The SmokePing configuration %s cannot be read: %s"
msgstr "Конфигурацията на SmokePing %s не може да бъде прочетена: %s"

