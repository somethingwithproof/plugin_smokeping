#: lib/HealthCheck.php
#, php-format
msgid "The SmokePing configuration %s lists %d targets; %d entries are skipped: %s"
msgstr "SmokePing კონფიგურაცია %s შეიცავს %d სამიზნეს; %d ჩანაწერი გამოტოვებულია: %s"

#: lib/HealthCheck.php
