#: lib/ImportPage.php lib/Pages.php
msgid "Import SmokePing Configuration"
msgstr "Uvoz konfiguracije SmokePinga"

#: lib/ImportPage.php
msgid "Configuration"
msgstr "Konfiguracija"

#: lib/ImportPage.php
msgid "The configured SmokePing file is read with the files it includes, from its own directory. An uploaded file is read on its own: @include is not allowed in it."
msgstr "Konfigurirana datoteka SmokePinga čita se zajedno s uključenim datotekama iz vlastite mape. Prenesena datoteka čita se zasebno: @include u njoj nije dopušten."

#: lib/ImportPage.php
#, php-format
msgid "The configured file, %s"
msgstr "Konfigurirana datoteka, %s"

#: lib/ImportPage.php
msgid "An uploaded file, without @include"
msgstr "Prenesena datoteka, bez @include"

#: lib/ImportPage.php
msgid "Uploaded File"
msgstr "Prenesena datoteka"

#: lib/ImportPage.php
msgid "Only for an uploaded file: a SmokePing configuration of at most 4 MiB."
msgstr "Samo za prenesenu datoteku: konfiguracija SmokePinga veličine do najviše 4 MiB."

#: lib/ImportPage.php
msgid "Devices"
msgstr "Uređaji"

#: lib/ImportPage.php
msgid "One device per SmokePing host groups targets that probe the same host. A device that already has the host name on the chosen poller is used instead of a new one."
msgstr "Mogućnost jedan uređaj po računalu SmokePinga grupira ciljeve koji ispituju isto računalo. Uređaj koji već ima taj naziv računala na odabranom polleru upotrebljava se umjesto stvaranja novog."

#: lib/ImportPage.php
msgid "One device per SmokePing host"
msgstr "Jedan uređaj po računalu SmokePinga"

#: lib/ImportPage.php
msgid "One device per SmokePing target"
msgstr "Jedan uređaj po cilju SmokePinga"

#: lib/ImportPage.php
msgid "Device Template"
msgstr "Predložak uređaja"

#: lib/ImportPage.php
msgid "The template of devices the import creates."
msgstr "Predložak uređaja koje uvoz stvara."

#: lib/ImportPage.php
msgid "Poller"
msgstr "Poller"

#: lib/ImportPage.php
msgid "The poller of new devices. It must be the poller that runs the SmokePing reader, or their summary data sources get no data."
msgstr "Poller za nove uređaje. Mora biti poller na kojem radi čitač SmokePinga jer inače njihovi sažeti izvori podataka neće primati podatke."

#: lib/ImportPage.php
msgid "Site"
msgstr "Lokacija"

#: lib/ImportPage.php
msgid "The site of new devices."
msgstr "Lokacija novih uređaja."

#: lib/ImportPage.php smokeping_inventory.php
msgid "None"
msgstr "Ništa"

#: lib/ImportPage.php
msgid "Graph Tree"
msgstr "Stablo grafova"

#: lib/ImportPage.php
msgid "Mirror the SmokePing hierarchy into a graph tree: each section becomes a branch, and each device a host under the branch of its targets. Existing branches and hosts are reused."
msgstr "Zrcali hijerarhiju SmokePinga u stablo grafova: svaki odjeljak postaje grana, a svaki uređaj računalo pod granom svojih ciljeva. Postojeće grane i računala ponovno se koriste."

#: lib/ImportPage.php
msgid "A new tree, named below"
msgstr "Novo stablo s nazivom navedenim u nastavku"

#: lib/ImportPage.php
msgid "Do not mirror"
msgstr "Ne zrcali"

#: lib/ImportPage.php
msgid "New Tree Name"
msgstr "Naziv novog stabla"

#: lib/ImportPage.php
msgid "Only for a new tree. A tree that already has this name is used."
msgstr "Samo za novo stablo. Upotrebljava se stablo koje već ima ovaj naziv."

#: lib/ImportPage.php
msgid "Preview reads the configuration and lists what the import would create. Nothing is written until you confirm that list on the next screen, and SmokePing's own files are never written."
msgstr "Pretpregled očitava konfiguraciju i prikazuje popis svega što bi uvoz stvorio. Ništa se ne zapisuje dok taj popis ne potvrdite na sljedećem zaslonu, a izvorne datoteke SmokePinga nikada se ne mijenjaju."

#: lib/ImportPage.php
msgid "Preview"
msgstr "Pretpregled"

#: lib/ImportPage.php
