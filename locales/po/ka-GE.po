msgstr "წამკითხველი იშვება ბრძანებით %s."

#: lib/HealthCheck.php
msgid "The reader has not completed a run on this poller."
msgstr "წამკითხველს ამ პოლერზე გაშვება ჯერ არ დაუსრულებია."

#: lib/HealthCheck.php
#, php-format
msgid "The last reader run finished %d seconds ago, more than three poller intervals."
msgstr "წამკითხველის ბოლო გაშვება დასრულდა %d წამის წინ, რაც პოლერის სამ ინტერვალზე მეტია."

#: lib/HealthCheck.php
#, php-format
