#: smokeping_config.php smokeping_import.php
msgid "No file was uploaded, or it is larger than the server accepts."
msgstr "Tsy nisy rakitra nampakarina, na lehibe noho izay eken'ny lohamilina izany."

#: smokeping_config.php
msgid "There is no checked import to apply. Check the file again."
msgstr "Tsy misy fanafarana voamarina hampiharina. Hamarino indray ny rakitra."

#: smokeping_config.php
msgid "The configuration was imported."
msgstr "Nafarana ny fikirakirana."

#: smokeping_health.php
msgid "The SmokePing templates failed to import. See the health table."
msgstr "Tsy nahomby ny fanafarana ny lasitra SmokePing. Jereo ny tabilao toe-pahasalamana."

#: smokeping_import.php
msgid "Your device permissions do not cover every device, so you cannot import a SmokePing configuration. Ask an administrator with access to all devices."
msgstr "Tsy maharakotra ny fitaovana rehetra ny fahazoan-dalanao momba ny fitaovana, ka tsy afaka manafatra fikirakirana SmokePing ianao. Manontania mpitantana manana fidirana amin'ny fitaovana rehetra."

#: smokeping_import.php
msgid "Name the new graph tree, or choose an existing tree or no tree."
msgstr "Omeo anarana ny hazo grafika vaovao, na misafidiana hazo efa misy na tsy misy hazo."

#: smokeping_import.php
msgid "The uploaded file is larger than 4 MiB."
msgstr "Ny rakitra nampakarina dia lehibe noho ny 4 MiB."

#: smokeping_import.php
#, php-format
msgid "The SmokePing configuration cannot be read, so nothing was imported: %s"
msgstr "Tsy azo vakiana ny fikirakirana SmokePing, ka tsy nisy na inona na inona nafarana: %s"

#: smokeping_import.php
msgid "There is no previewed import to apply. Preview it again."
msgstr "Tsy misy fanafarana nojerena mialoha hampiharina. Jereo mialoha indray izany."

#: smokeping_import.php
#, php-format
msgid "and %d more; see the Cacti log"
msgstr "sy %d fanampiny; jereo ny firaketana Cacti"

#: smokeping_import.php
msgid "The SmokePing configuration was imported."
msgstr "Nafarana ny fikirakirana SmokePing."

#: smokeping_inventory.php
