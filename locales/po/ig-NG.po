#: lib/Settings.php
msgid "The Cacti poller that runs on, or shares a filesystem with, the SmokePing host. Only this poller reads SmokePing data."
msgstr "Poller Cacti nke na-arụ ọrụ n'elu, ma ọ bụ na-ekekọrịta sistemụ faịlụ ya na, igwe SmokePing. Naanị poller a na-agụ data SmokePing."

#: lib/Settings.php
msgid "SmokePing Configuration File"
msgstr "Faịlụ Nhazi SmokePing"

#: lib/Settings.php
msgid "The main SmokePing configuration file, read by the poller that runs the reader. The plugin reads it and the files it includes with its own parser and never writes to them. Includes must stay inside this file's directory."
msgstr "Isi faịlụ nhazi SmokePing, nke poller na-arụ ọrụ ihe ọgụgụ na-agụ. Plọgin a na-agụ ya na faịlụ ndị ọ gụnyere site na iji ngwa nyocha ya n'onwe ya ma ọ dịghị mgbe ọ na-ede ihe n'ime ha. Ihe ndị a gụnyere ga-anọrịrị n'ime ndekọ faịlụ a."

#: lib/Settings.php
msgid "SmokePing Data Directory"
msgstr "Ndekọ Data SmokePing"

#: lib/Settings.php
msgid "The datadir from SmokePing's configuration, as SmokePing sees it."
msgstr "Ndekọ datadir sitere na nhazi SmokePing, dịka SmokePing si ahụ ya."

#: lib/Settings.php
msgid "Cacti Mount of the Data Directory"
msgstr "Njikọ Mount Cacti nke Ndekọ Data"

#: lib/Settings.php
msgid "A read-only bind or NFS mount of the SmokePing data directory inside the Cacti RRA path. Cacti only reads RRD files inside its RRA path and never through a symlink."
msgstr "Njikọ bind ma ọ bụ NFS nke naanị ọgụgụ nke ndekọ data SmokePing n'ime ụzọ RRA nke Cacti. Cacti na-agụ naanị faịlụ RRD dị n'ime ụzọ RRA ya ma ọ dịghị mgbe ọ na-agụ site na symlink."

#: lib/Settings.php
msgid "Reader"
msgstr "Ngwa Ọgụgụ"

#: lib/Settings.php
msgid "Reader Time Budget"
msgstr "Oke Oge Ngwa Ọgụgụ"

#: lib/Settings.php
msgid "Seconds one reader run may spend reading RRD files before it stops and resumes on the next poller cycle."
msgstr "Sekọnd ole otu ọrụ ihe ọgụgụ nwere ike iji gụọ faịlụ RRD tupu ọ kwụsị ma maliteghachi n'usoro poller na-esote."

#: lib/Settings.php
msgid "Inventory Interval"
msgstr "Oge Ndepụta Nchịkọta"

#: lib/Settings.php
msgid "Minimum seconds between inventory runs. The inventory also runs when the configuration file changes."
msgstr "Sekọnd kacha nta dị n'etiti ọrụ ndepụta nchịkọta. Ndepụta nchịkọta na-arụkwa ọrụ mgbe faịlụ nhazi gbanwere."

